-    else if (b.glu_t.on) { for (int k = 0; k < 2; ++k) P.add(T_SHARED, b.glu_t.a.w[k], static_cast<size_t>(b.glu_t.a.K) * b.glu_t.a.N * dtr::BITS / 8); }
+    else if (b.glu_t.on) { for (int k = 0; k < 2; ++k) P.add(T_SHARED, b.glu_t.a.w[k], static_cast<size_t>(b.glu_t.a.K) * b.glu_t.a.N * dtr::fbits(b.glu_t.fmt) / 8); }
     else { for (int k = 0; k < 2; ++k) P.add(T_SHARED, b.sh[k].p, bind::rec_bytes(b.sh[k])); }
     return P;
 }
diff --git a/engine/kernels/tests/dtr_ml4_test.cu b/engine/kernels/tests/dtr_ml4_test.cu
new file mode 100644
index 0000000..439fdd5
--- /dev/null
+++ b/engine/kernels/tests/dtr_ml4_test.cu
@@ -0,0 +1,173 @@
+// ML4 dense trellis matrices (dtr.cuh format 1: K3 mul1, no E4M3) on real pack slices: decode GEMV outputs for the
+// reference check (engine/ref/dtr_ml4_ref.py writes the inputs and checks the outputs against ExLlamaV3's weights).
+//
+//   nvcc -O2 -std=c++17 -gencode=arch=compute_121a,code=sm_121a -DG6_NR=4 -DDEC_S2 -DG6_MODEL_ML4=1 -I.. \
+//        -o dtr_ml4_test dtr_ml4_test.cu <knobs link flags as dtr_test>
+//   dtr_ml4_test DIR
+//
+// DIR/meta.txt, one line each:
+//   mat NAME SIDE K N R       NAME.codes.bin u8 [E][entry bytes], NAME.suh.bin f16 [K], NAME.svh.bin f16 [N],
+//                             NAME.x.bin f16 [R][K]
+//   glu GATE UP DOWN          gate and up on GATE.x.bin, then down (dtr::make_glu + make_out)
+//   gv NAME K O R             F16W GEMV (bind.cuh, G6_MODEL_ML4): NAME.rec.bin u8 [O/16][K/16][512] (fp16 weights in
+//                             the BF16W record order), NAME.x.bin f16 [R][K]; fp16 fragments by k_xfrag
+// Outputs: NAME.gemv.M<m>.bin, glu.gemv.M<m>.bin f32 [m][N], M = 1..G6_MX (up to R).
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+#include <cuda_bf16.h>
+#include "../bind.cuh"
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { fprintf(stderr, "%s:%d %s: %s\n", __FILE__, __LINE__, #x, cudaGetErrorString(e_)); exit(1); } } while (0)
+static void die(const std::string& s) { fprintf(stderr, "error: %s\n", s.c_str()); exit(1); }
+static void ok(const char* e) { if (e) die(e); }
+static std::vector<uint8_t> slurp(const std::string& p)
+{
+    std::ifstream f(p, std::ios::binary);
+    if (!f) die("cannot read " + p);
+    return std::vector<uint8_t>((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+}
+static void dump_dev(const std::string& p, const void* d, size_t n)
+{
+    std::vector<uint8_t> h(n);
+    CK(cudaMemcpy(h.data(), d, n, cudaMemcpyDeviceToHost));
+    FILE* f = fopen(p.c_str(), "wb");
+    if (!f || fwrite(h.data(), 1, n, f) != n) die("cannot write " + p);
+    fclose(f);
+}
+static void* up(const std::vector<uint8_t>& h)
+{
+    void* d;
+    CK(cudaMalloc(&d, h.size()));
+    CK(cudaMemcpy(d, h.data(), h.size(), cudaMemcpyHostToDevice));
+    return d;
+}
+struct View { const void* p = nullptr; int nd = 0; long long shape[4] = {}; };
+static View ten(const void* p, std::initializer_list<long long> s)
+{
+    View v; v.p = p; v.nd = static_cast<int>(s.size());
+    int i = 0;
+    for (long long x : s) v.shape[i++] = x;
+    return v;
+}
+struct HostMat { std::string name; int side, K, N, R, E; long long eb; void *codes, *suh, *svh, *x; dtr::Mat m; };
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) die("usage: dtr_ml4_test DIR");
+    const std::string dir = argv[1];
+    CK(dtr::init());
+    std::map<std::string, HostMat> mats;
+    std::vector<std::vector<std::string>> glus;
+    struct HostGv { std::string name; int K, O, R; void *rec, *x; };
+    std::vector<HostGv> gvs;
+    std::ifstream meta(dir + "/meta.txt");
+    std::string line;
+    while (std::getline(meta, line))
+    {
+        std::istringstream is(line);
+        std::string kind;
+        is >> kind;
+        if (kind == "mat")
+        {
+            HostMat h;
+            is >> h.name >> h.side >> h.K >> h.N >> h.R;
+            const std::vector<uint8_t> c = slurp(dir + "/" + h.name + ".codes.bin");
+            h.E = (h.side == dtr::SIDE_OUT ? h.N : h.K) / 128;
+            h.eb = static_cast<long long>(c.size()) / h.E;
+            h.codes = up(c);
+            h.suh = up(slurp(dir + "/" + h.name + ".suh.bin"));
+            h.svh = up(slurp(dir + "/" + h.name + ".svh.bin"));
+            h.x = up(slurp(dir + "/" + h.name + ".x.bin"));
+            ok(dtr::make_mat(ten(h.codes, {h.E, h.eb}), ten(h.suh, {h.K}), ten(h.svh, {h.N}), h.side, h.m));
+            if (h.m.fmt != 1) die(h.name + ": not the K3 mul1 format (fmt " + std::to_string(h.m.fmt) + ")");
+            mats[h.name] = h;
+        }
+        else if (kind == "gv")
+        {
+            HostGv h;
+            is >> h.name >> h.K >> h.O >> h.R;
+            h.rec = up(slurp(dir + "/" + h.name + ".rec.bin"));
+            h.x = up(slurp(dir + "/" + h.name + ".x.bin"));
+            gvs.push_back(h);
+        }
+        else if (kind == "glu")
+        {
+            std::vector<std::string> g(3);
+            is >> g[0] >> g[1] >> g[2];
+            glus.push_back(g);
+        }
+    }
+    int maxN = 0;
+    for (auto& kv : mats) maxN = std::max(maxN, std::max(kv.second.N, kv.second.K));
+    dtr::Scratch sc;
+    sc.part_n = dtr::part_floats(maxN, 2, 64, G6_MX);
+    sc.cnt_n = 4096;
+    CK(cudaMalloc(&sc.part, sc.part_n * 4));
+    CK(cudaMalloc(&sc.cnt, sc.cnt_n * 4));
+    CK(cudaMemset(sc.cnt, 0, sc.cnt_n * 4));
+    float* y;
+    CK(cudaMalloc(&y, static_cast<size_t>(G6_MX) * maxN * 4));
+    cudaStream_t st;
+    CK(cudaStreamCreate(&st));
+    for (auto& kv : mats)
+    {
+        HostMat& h = kv.second;
+        for (int M = 1; M <= G6_MX && M <= h.R; ++M)
+        {
+            dtr::Gemv g;
+            ok(dtr::make_out(h.m, M, static_cast<const __half*>(h.x), h.K, nullptr, y, h.N, dtr::O_F32, sc, 0, 0, 1, g));
+            dtr::launch(g, st);
+            CK(cudaStreamSynchronize(st));
+            CK(cudaGetLastError());
+            dump_dev(dir + "/" + h.name + ".gemv.M" + std::to_string(M) + ".bin", y, static_cast<size_t>(M) * h.N * 4);
+        }
+        printf("%s: side %d K %d N %d, %d entries x %lld B (fmt %d): M = 1..%d dumped\n", h.name.c_str(), h.side, h.K, h.N,
+               h.E, h.eb, h.m.fmt, std::min(G6_MX, h.R));
+    }
+    for (const HostGv& h : gvs)
+    {
+        u32* xf;
+        float* yo;
+        CK(cudaMalloc(&xf, static_cast<size_t>(g6mx::NT) * (h.K / 16) * 64 * 4));
+        CK(cudaMalloc(&yo, static_cast<size_t>(G6_MX) * h.O * 4));
+        bind::Tensor t;
+        t.p = h.rec; t.nd = 3; t.shape[0] = h.O / 16; t.shape[1] = h.K / 16; t.shape[2] = 512;
+        for (int M = 1; M <= G6_MX && M <= h.R; ++M)
+        {
+            bind::Xfrag xa;
+            xa.on = 1; xa.src = static_cast<const __half*>(h.x); xa.ld = h.K; xa.K = h.K; xa.M = M; xa.f16 = xf;
+            bind::launch(xa, st);
+            bind::Gv g;
+            ok(bind::make_gv(t, bind::F16W, 1, 32, M, xf, yo, gv::O_F32, g));
+            bind::launch(g, st);
+            CK(cudaStreamSynchronize(st));
+            CK(cudaGetLastError());
+            dump_dev(dir + "/" + h.name + ".gemv.M" + std::to_string(M) + ".bin", yo, static_cast<size_t>(M) * h.O * 4);
+        }
+        printf("gv %s: F16W K %d O %d: M = 1..%d dumped\n", h.name.c_str(), h.K, h.O, std::min(G6_MX, h.R));
+    }
+    for (const auto& gl : glus)
+    {
+        HostMat &G = mats.at(gl[0]), &U = mats.at(gl[1]), &D = mats.at(gl[2]);
+        u32* xd;
+        CK(cudaMalloc(&xd, static_cast<size_t>(g6mx::NT) * (G.N / 16) * 64 * 4));
+        for (int M = 1; M <= G6_MX && M <= G.R; ++M)
+        {
+            dtr::Gemv a, b;
+            ok(dtr::make_glu(G.m, U.m, D.m, M, static_cast<const __half*>(G.x), G.K, xd, sc, 0, 0, 1, a));
+            ok(dtr::make_out(D.m, M, nullptr, 0, xd, y, D.N, dtr::O_F32, sc, 2048, 0, 1, b));
+            dtr::launch(a, st);
+            dtr::launch(b, st);
+            CK(cudaStreamSynchronize(st));
+            CK(cudaGetLastError());
+            dump_dev(dir + "/glu.gemv.M" + std::to_string(M) + ".bin", y, static_cast<size_t>(M) * D.N * 4);
+        }
+        printf("glu %s %s %s: M = 1..%d dumped\n", gl[0].c_str(), gl[1].c_str(), gl[2].c_str(), std::min(G6_MX, G.R));
+    }
+    return 0;
+}
diff --git a/engine/ref/dtr_ml4_ref.py b/engine/ref/dtr_ml4_ref.py
new file mode 100644
index 0000000..0c4ecdb
--- /dev/null
+++ b/engine/ref/dtr_ml4_ref.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Inputs and the check for dtr_ml4_test (dtr.cuh format 1: ML4's EXL3 K3 mul1 matrices, rank 0 of TP4).
+
+  dtr_ml4_ref.py prep PACK_DIR EXL3_REF_DIR DIR    rank 0's slices of layer 5 wq (side 1, heads 0-15 = 2048 columns),
+                                                   layer 5 wo (side 2, rows 0-2047) and layer 0's dense MLP (channels
+                                                   0-6143: w1 gate, w3 up side 1, w2 down side 2) in dtr's entry
+                                                   layout, tiles copied as stored, + 8 random input rows each
+  dtr_ml4_ref.py check PACK_DIR EXL3_REF_DIR DIR   y = x @ W_eff (exl3_ref.dequant_exl3: ExLlamaV3's weights, fp32) for
+                                                   every dumped M; rel L2 per matrix, and whether row r's output is
+                                                   bit-identical for every M > r (row-count invariance)
+Also F16W GEMVs (bind.cuh codec F16W) on the layer 5 kv_a (576 rows of the 640 stored), router (128) and 2048 rows of
+the lm_head dequantized to fp16 once (the converter's form of ML4's head): y = x @ W.T against fp32.
+Entry layouts (dtr.cuh): side 1, entry e = output columns 128e..: trellis[:, 8e:8e+8] in [k16][c] order;
+side 2, entry e = input rows 128e..: trellis[8e:8e+8, 8b:8b+8] in [b][r][c] order.
+"""
+import json
+import os
+import struct
+import sys
+
+import numpy as np
+import torch
+
+mode, pack, refdir, D = sys.argv[1:5]
+sys.path.insert(0, refdir)
+import exl3_ref  # noqa: E402
+
+index = json.load(open(os.path.join(pack, 'model.safetensors.index.json')))['weight_map']
+DT = {'I16': np.int16, 'F16': np.float16, 'I32': np.int32}
+
+
+def raw(name):
+    f = os.path.join(pack, index[name])
+    with open(f, 'rb') as fh:
+        n = struct.unpack('<Q', fh.read(8))[0]
+        m = json.loads(fh.read(n))[name]
+        s, e = m['data_offsets']
+        fh.seek(8 + n + s)
+        return np.frombuffer(fh.read(e - s), DT[m['dtype']]).reshape(m['shape'])
+
+
+MATS = [  # name, pack prefix, side, sharded range (side 1: output columns, side 2: input rows)
+    ('wq5', 'layers.5.attention.wq', 1, (0, 2048)),
+    ('wo5', 'layers.5.attention.wo', 2, (0, 2048)),
+    ('g0', 'layers.0.feed_forward.w1', 1, (0, 6144)),
+    ('u0', 'layers.0.feed_forward.w3', 1, (0, 6144)),
+    ('d0', 'layers.0.feed_forward.w2', 2, (0, 6144)),
+]
+R = 8
+GVS = [('kva5', 'layers.5.attention.wkv_a_with_mqa.weight', 576), ('gate5', 'layers.5.gate.weight', 128), ('head', 'output', 2048)]
+
+
+def gv_order():
+    o = []
+    for l in range(32):
+        r, c = l // 4, l % 4
+        o += [(r, 2 * c), (r, 2 * c + 1), (r + 8, 2 * c), (r + 8, 2 * c + 1), (r, 2 * c + 8), (r, 2 * c + 9), (r + 8, 2 * c + 8), (r + 8, 2 * c + 9)]
+    return np.array(o)
+
+
+def f16_record(w):
+    """w fp16 [O][K] -> u8 [O/16][K/16][512]: one 16x16 tile per group in the GEMV lane order (records.rs bf16_record)."""
+    O, K = w.shape
+    o = gv_order()
+    t = w.reshape(O // 16, 16, K // 16, 16).transpose(0, 2, 1, 3)       # [ot][kt][r][c]
+    return np.ascontiguousarray(t[:, :, o[:, 0], o[:, 1]]).view(np.uint8)
+
+
+def gv_weight(pre, rows):
+    if pre == 'output':            # the 6-bit head: W_eff (ExLlamaV3's weight) to fp16, [rows][6144]
+        w = exl3_ref.dequant_exl3(torch.from_numpy(raw('output.trellis')[:, :rows // 16].copy()),
+                                  torch.from_numpy(raw('output.suh').copy()), torch.from_numpy(raw('output.svh')[:rows].copy()),
+                                  mul1=int(raw('output.mul1').reshape(-1)[0]))
+        return w.T.contiguous().half().numpy()
+    return raw(pre)[:rows].astype(np.float16)
+
+
+def slice_of(pre, side, lo, hi):
+    tr, suh, svh = raw(pre + '.trellis'), raw(pre + '.suh'), raw(pre + '.svh')
+    KT, NT, W = tr.shape
+    if side == 1:
+        ent = np.stack([tr[:, 8 * e:8 * e + 8] for e in range(lo // 128, hi // 128)])          # [E][k16][8][W]
+        return ent, suh, svh[lo:hi], KT * 16, hi - lo
+    ent = np.stack([tr[8 * e:8 * e + 8].reshape(8, NT // 8, 8, W).transpose(1, 0, 2, 3)        # [E][b][r][c][W]
+                    for e in range(lo // 128, hi // 128)])
+    return ent, suh[lo:hi], svh, hi - lo, NT * 16
+
+
+if mode == 'prep':
+    os.makedirs(D, exist_ok=True)
+    g = torch.Generator().manual_seed(5)
+    meta = []
+    for name, pre, side, (lo, hi) in MATS:
+        ent, suh, svh, K, N = slice_of(pre, side, lo, hi)
+        ent.astype(np.int16).tofile(os.path.join(D, name + '.codes.bin'))
+        suh.astype(np.float16).tofile(os.path.join(D, name + '.suh.bin'))
+        svh.astype(np.float16).tofile(os.path.join(D, name + '.svh.bin'))
+        if name == 'u0':      # make_glu runs gate and up on one input
+            x = np.fromfile(os.path.join(D, 'g0.x.bin'), np.float16)
+        else:
+            x = torch.randn(R, K, generator=g).half().numpy()
+        x.tofile(os.path.join(D, name + '.x.bin'))
+        meta.append(f'mat {name} {side} {K} {N} {R}')
+    meta.append('glu g0 u0 d0')
+    for name, pre, rows in GVS:
+        w = gv_weight(pre, rows)
+        f16_record(w).tofile(os.path.join(D, name + '.rec.bin'))
+        w.tofile(os.path.join(D, name + '.w.bin'))
+        torch.randn(R, w.shape[1], generator=g).half().numpy().tofile(os.path.join(D, name + '.x.bin'))
+        meta.append(f'gv {name} {w.shape[1]} {rows} {R}')
+    open(os.path.join(D, 'meta.txt'), 'w').write('\n'.join(meta) + '\n')
+    print('prep:', '; '.join(meta))
+    sys.exit(0)
+
+W = {}
+for name, pre, side, (lo, hi) in MATS:
+    w = exl3_ref.dequant_exl3(torch.from_numpy(raw(pre + '.trellis').copy()), torch.from_numpy(raw(pre + '.suh').copy()),
+                              torch.from_numpy(raw(pre + '.svh').copy()), mul1=int(raw(pre + '.mul1').reshape(-1)[0]))
+    W[name] = w[:, lo:hi] if side == 1 else w[lo:hi, :]
+bad = 0
+
+
+def check(label, ref, outs):
+    global bad
+    worst, inv = 0.0, True
+    for M, y in outs.items():
+        rel = float((torch.from_numpy(y) - ref[:M]).norm() / ref[:M].norm())
+        worst = max(worst, rel)
+    full = outs[max(outs)]
+    for M, y in outs.items():
+        inv &= bool(np.array_equal(y, full[:M]))
+    ok = worst <= 1e-3                 # the M1 gate (docs/PORT.md); row-count invariance is reported, gated at M3
+    bad |= not ok
+    print(f'{label}: rel L2 vs fp32 x @ W_eff, worst over M = 1..{max(outs)}: {worst:.3e} -> {"PASS" if ok else "FAIL"}; '
+          f'row r bit-identical for every M: {inv}' + ('' if inv else ' (split_for picks another k split per M: M3 item)'))
+
+
+def dumps(prefix, N):
+    out = {}
+    for M in range(1, R + 1):
+        p = os.path.join(D, f'{prefix}.gemv.M{M}.bin')
+        if os.path.exists(p):
+            out[M] = np.fromfile(p, np.float32).reshape(M, N)
+    return out
+
+
+for name, pre, side, (lo, hi) in MATS:
+    x = torch.from_numpy(np.fromfile(os.path.join(D, name + '.x.bin'), np.float16).reshape(R, -1).astype(np.float32))
+    check(f'{name} ({pre}, side {side})', x @ W[name], dumps(name, W[name].shape[1]))
+x = torch.from_numpy(np.fromfile(os.path.join(D, 'g0.x.bin'), np.float16).reshape(R, -1).astype(np.float32))
+a = torch.nn.functional.silu(x @ W['g0']) * (x @ W['u0'])
+check('glu g0 u0 d0 (layer 0 dense MLP, rank 0 channels)', a @ W['d0'], dumps('glu', W['d0'].shape[1]))
+for name, pre, rows in GVS:
+    w = torch.from_numpy(np.fromfile(os.path.join(D, name + '.w.bin'), np.float16).reshape(rows, -1).astype(np.float32))
+    x = torch.from_numpy(np.fromfile(os.path.join(D, name + '.x.bin'), np.float16).reshape(R, -1).astype(np.float32))
+    check(f'F16W {name} ({pre}, {rows} x {w.shape[1]})', x @ w.T, dumps(name, rows))
+sys.exit(1 if bad else 0)
-- 
2.43.0

