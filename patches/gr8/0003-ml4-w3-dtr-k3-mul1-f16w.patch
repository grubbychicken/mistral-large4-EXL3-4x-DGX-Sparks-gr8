 enum { O_F16 = 0, O_BF16 = 1, O_F32 = 2 };
 constexpr int BITS = 4;               // the release stores every dense trellis matrix at K4
+// Formats of a dense trellis matrix (Mat::fmt, the kernels' F): 0 = the release's K4 with E4M3 rounding and the mcg
+// codebook (every model). Under G6_MODEL_ML4 also 1 = K3 with the mul1 codebook and no E4M3 rounding: the EXL3
+// 3.0 bpw pack of Mistral Large 4 (wq, wo, the layer 0 MLP), decoded exactly as ExLlamaV3 does. K6 (ML4's lm_head)
+// does not fit this kernel: a lane loads one word of a tile and a K6 tile has 48 (the head goes as F16W records,
+// docs/PORT.md). Builds without G6_MODEL_ML4 instantiate F = 0 only (the same kernels as before).
+#if G6_MODEL_ML4
+constexpr int NFMT = 2;
+#else
+constexpr int NFMT = 1;
+#endif
+__host__ __device__ constexpr int fbits(int f) { return f == 1 ? 3 : BITS; }
+__host__ __device__ constexpr bool fe4(int f) { return f == 0; }
+__host__ __device__ constexpr int fcb(int f) { return f == 0 ? TR3_MCG : TR3_MUL1; }
+static_assert(NFMT == 1 || tr3_cb_built(TR3_MUL1), "G6_MODEL_ML4 needs the mul1 codebook built (G6_TR3_CBS bit 1)");
 constexpr int UNR = 16;               // tiles in flight per warp
 constexpr int SMEM_MAX = 98304;       // dynamic shared memory attribute (init)
 
