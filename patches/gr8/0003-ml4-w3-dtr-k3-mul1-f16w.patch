diff --git a/engine/kernels/densev.cuh b/engine/kernels/densev.cuh
index fafeedc..3a97d34 100644
--- a/engine/kernels/densev.cuh
+++ b/engine/kernels/densev.cuh
@@ -91,6 +91,24 @@ struct Bf16w
     static __device__ __forceinline__ float2 scale(u32) { return make_float2(1.f, 1.f); }
 };
 
+#if G6_MODEL_ML4
+// F16 weights in the BF16W record (one 16x16 tile of fp16 bits per group, 512 B, the same lane order), fp16 activation
+// fragments (xf_x, as MXFP8 and int4 read them), fp16 mma with fp32 accumulate. Mistral Large 4's kv_a, indexer, router
+// and head weights are fp16 values (bit-exact bf16 originals): BF16W would round the activations to bf16 (2^-9),
+// this keeps them at fp16 (2^-11).
+struct F16w
+{
+    static constexpr int G = 1, TW = 4, GR = 512, PFB = 4;
+    static constexpr bool SCALED = false, ROW_SCALED = false;
+    static __device__ __forceinline__ void ld_tile(const uint8_t* tile, int lane, u32* w) { gv::ld_nc_v4(tile + lane * 16, w); }
+    static __device__ __forceinline__ void dec(const u32* w, u32 (&a)[4]) { a[0] = w[0]; a[1] = w[1]; a[2] = w[2]; a[3] = w[3]; }
+    static __device__ __forceinline__ void mma_a(float (&g)[4], const u32 (&a)[4], u32 b0, u32 b1) { mma16816(g, a[0], a[1], a[2], a[3], b0, b1); }
+    static __device__ __forceinline__ void mma(float (&g)[4], const u32* w, u32 b0, u32 b1) { mma16816(g, w[0], w[1], w[2], w[3], b0, b1); }
+    static __device__ __forceinline__ u32 ld_scale(const uint8_t*, int) { return 0; }
+    static __device__ __forceinline__ float2 scale(u32) { return make_float2(1.f, 1.f); }
+};
+#endif
+
 // int4 g32 W4A16 (the K2 / rt_record layout of rowtile.cuh) behind the same interface, so o_proj and the other
 // D8 producers get the output dtype switch: gv_gemv<Int4v> with odt = O_BF16 writes a fabric partial directly.
 struct Int4v
