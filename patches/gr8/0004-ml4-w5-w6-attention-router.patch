diff --git a/engine/kernels/ml4_glue.cuh b/engine/kernels/ml4_glue.cuh
new file mode 100644
index 0000000..fb511ab
--- /dev/null
+++ b/engine/kernels/ml4_glue.cuh
@@ -0,0 +1,101 @@
+// Mistral Large 4 glue around gr8's GLM attention core (docs/PORT.md section 6 of the recipe): ML4 is presented to the
+// core in GLM's attention shape. Our own code; G6_MODEL_ML4 builds only.
+//
+//   k_ml4_qprep    q_raw [M][Hr][128] fp16 (wq, dtr) -> q_b [M][Hr][256] fp16 in GLM's layout [192 nope | 64 rope]:
+//                  f = (s_h ln(pos + 1) + b_h) * sqrt(2)   (ssmax; sqrt(2) turns the core's 256^-0.5 into 128^-0.5)
+//                  rope layers: nope [0, 64) = f q[0, 64), [64, 192) = 0, rope [192, 256) = f q[64, 128)
+//                  NoPE layers: nope [0, 128) = f q[0, 128), [128, 256) = 0
+//                  (transformers applies ssmax after rope; one scalar per head and row commutes with the rotation)
+//   k_ml4_ln       y = LayerNorm(x) w + b (eps 1e-6, fp32 statistics), fp16 out: the indexer's q_input_norm
+//   k_ml4_ssmax    in place on [M][NH][D] fp16: v *= s_h ln(pos + 1) + b_h (the indexer's ssmax, 32 heads of 128)
+//   k_ml4_compact  attn [M][Hr][256] fp16 (the core's output, value dims 128-255 zero) -> [M][Hr * 128] for wo
+//   k_ml4_softcap  in place on the head's fp32 logits [M][ld] (vn used): 30 tanh(x / 30) (final_logit_softcapping)
+#pragma once
+#include <cuda_fp16.h>
+#include "../model_geom.h"
+
+namespace ml4
+{
+// grid (Hr, M), block 128
+__global__ void __launch_bounds__(128) k_ml4_qprep(const __half* q_raw, const int* pos, const float* ss, int h0, int hr, int rope,
+                                                   __half* q_b)
+{
+    const int h = blockIdx.x, m = blockIdx.y, t = threadIdx.x, hg = h0 + h;
+    const float f = (ss[hg] * logf(static_cast<float>(pos[m]) + 1.f) + ss[64 + hg]) * 1.41421356237309515f;
+    const __half* q = q_raw + (static_cast<size_t>(m) * hr + h) * 128;
+    __half* o = q_b + (static_cast<size_t>(m) * hr + h) * 256;
+    const float v = __half2float(q[t]) * f;
+    if (rope)
+    {
+        if (t < 64) { o[t] = __float2half_rn(v); o[64 + t] = __float2half_rn(0.f); }
+        else { o[192 + t - 64] = __float2half_rn(v); o[64 + t] = __float2half_rn(0.f); }   // t >= 64: zero [128, 192)
+    }
+    else
+    {
+        o[t] = __float2half_rn(v);
+        o[128 + t] = __float2half_rn(0.f);
+    }
+}
+inline void qprep(const __half* q_raw, const int* pos, const float* ss, int h0, int hr, int rope, __half* q_b, int M, cudaStream_t st)
+{
+    k_ml4_qprep<<<dim3(hr, M), 128, 0, st>>>(q_raw, pos, ss, h0, hr, rope, q_b);
+}
+
+// grid M, block 256; K = 6144
+__global__ void __launch_bounds__(256) k_ml4_ln(const __half* x, int ldx, const float* wb, int K, __half* y, int ldy)
+{
+    const int m = blockIdx.x, t = threadIdx.x;
+    const __half* xr = x + static_cast<size_t>(m) * ldx;
+    __shared__ float red[2][8];
+    float s = 0.f;
+    for (int k = t; k < K; k += 256) s += __half2float(xr[k]);
+    for (int o = 16; o; o >>= 1) s += __shfl_xor_sync(0xffffffffu, s, o);
+    if ((t & 31) == 0) red[0][t >> 5] = s;
+    __syncthreads();
+    float mean = 0.f;
+    for (int i = 0; i < 8; ++i) mean += red[0][i];
+    mean /= K;
+    float v = 0.f;
+    for (int k = t; k < K; k += 256) { const float d = __half2float(xr[k]) - mean; v += d * d; }
+    for (int o = 16; o; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+    if ((t & 31) == 0) red[1][t >> 5] = v;
+    __syncthreads();
+    float var = 0.f;
+    for (int i = 0; i < 8; ++i) var += red[1][i];
+    const float r = rsqrtf(var / K + 1e-6f);
+    for (int k = t; k < K; k += 256)
+        y[static_cast<size_t>(m) * ldy + k] = __float2half_rn((__half2float(xr[k]) - mean) * r * wb[k] + wb[K + k]);
+}
+inline void ln(const __half* x, int ldx, const float* wb, int K, __half* y, int ldy, int M, cudaStream_t st)
+{
+    k_ml4_ln<<<M, 256, 0, st>>>(x, ldx, wb, K, y, ldy);
+}
+
+// grid (NH, M), block D
+__global__ void k_ml4_ssmax(__half* v, const int* pos, const float* ss, int nh, int d)
+{
+    const int h = blockIdx.x, m = blockIdx.y, t = threadIdx.x;
+    const float f = ss[h] * logf(static_cast<float>(pos[m]) + 1.f) + ss[nh + h];
+    __half* p = v + (static_cast<size_t>(m) * nh + h) * d + t;
+    *p = __float2half_rn(__half2float(*p) * f);
+}
+inline void ssmax(__half* v, const int* pos, const float* ss, int nh, int d, int M, cudaStream_t st)
+{
+    k_ml4_ssmax<<<dim3(nh, M), d, 0, st>>>(v, pos, ss, nh, d);
+}
+
+// grid (Hr, M), block 128
+__global__ void __launch_bounds__(128) k_ml4_compact(const __half* a, int hr, __half* o)
+{
+    const int h = blockIdx.x, m = blockIdx.y, t = threadIdx.x;
+    o[(static_cast<size_t>(m) * hr + h) * 128 + t] = a[(static_cast<size_t>(m) * hr + h) * 256 + t];
+}
+inline void compact(const __half* a, int hr, __half* o, int M, cudaStream_t st) { k_ml4_compact<<<dim3(hr, M), 128, 0, st>>>(a, hr, o); }
+// grid (ceil(vn / 256), M), block 256
+__global__ void __launch_bounds__(256) k_ml4_softcap(float* y, int ld, int vn, float cap)
+{
+    const int i = blockIdx.x * 256 + threadIdx.x, m = blockIdx.y;
+    if (i < vn) { float* p = y + static_cast<size_t>(m) * ld + i; *p = cap * tanhf(*p / cap); }
+}
+inline void softcap(float* y, int ld, int vn, int M, cudaStream_t st) { k_ml4_softcap<<<dim3((vn + 255) / 256, M), 256, 0, st>>>(y, ld, vn, geom::SOFTCAP); }
+}   // namespace ml4
diff --git a/engine/kernels/tests/router_ml4_test.cu b/engine/kernels/tests/router_ml4_test.cu
new file mode 100644
index 0000000..7aefa53
--- /dev/null
+++ b/engine/kernels/tests/router_ml4_test.cu
@@ -0,0 +1,73 @@
+// glue::k_router_plan_ml4 (Mistral Large 4: softmax top-4 of 128 + the shared row 128) against a CPU reference of
+// transformers' MistralLarge4TextTopkRouter, on random logits (ties included) at M = 1, 2, 3, 8, 13, 32 (DEC_S2).
+//   nvcc -O2 -std=c++17 -gencode=arch=compute_121a,code=sm_121a -DG6_NR=4 -DDEC_S2 -DG6_MODEL_ML4=1 -DML4_BENCH_NEXP=129 \
+//        -I.. -o router_ml4_test router_ml4_test.cu
+// Checks per token: the 4 routed experts are the top 4 by logit (ties -> lowest id), weights = softmax over all 128
+// gathered and renormalized (fp64 reference, |d| <= 1e-6), route 4 = expert 128 with weight 1; and the plan's slots:
+// ascending expert id, every (slot, column) points back at its token, n_slots matches.
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <vector>
+#include "../glue.cuh"
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { fprintf(stderr, "%s:%d %s\n", __FILE__, __LINE__, cudaGetErrorString(e_)); return 1; } } while (0)
+
+int main()
+{
+    using namespace glue;
+    std::mt19937 rng(7);
+    std::normal_distribution<float> nd(0.f, 2.f);
+    float* dl;
+    RoutePlan* dp;
+    CK(cudaMalloc(&dl, MMAX * NEXP_R * 4));
+    CK(cudaMalloc(&dp, sizeof(RoutePlan)));
+    int bad = 0;
+    for (int M : {1, 2, 3, 8, 13, MMAX})
+        for (int trial = 0; trial < 20; ++trial)
+        {
+            if (M > MMAX) continue;
+            std::vector<float> lg(M * NEXP_R);
+            for (float& v : lg) v = nd(rng);
+            if (trial % 4 == 1)                     // ties: a few copies of one logit, some among the top
+                for (int m = 0; m < M; ++m) { const float v = lg[m * NEXP_R + 5]; lg[m * NEXP_R + 9] = v; lg[m * NEXP_R + 70] = v + 10; lg[m * NEXP_R + 71] = v + 10; }
+            CK(cudaMemcpy(dl, lg.data(), lg.size() * 4, cudaMemcpyHostToDevice));
+            k_router_plan_ml4<<<1, ML4_RT>>>(dl, M, dp);
+            CK(cudaDeviceSynchronize());
+            RoutePlan P;
+            CK(cudaMemcpy(&P, dp, sizeof P, cudaMemcpyDeviceToHost));
+            int nslot_ref = 0;
+            std::vector<int> cnt(NEXP, 0);
+            for (int m = 0; m < M; ++m)
+            {
+                std::vector<int> id(NEXP_R);
+                for (int e = 0; e < NEXP_R; ++e) id[e] = e;
+                const float* L = &lg[m * NEXP_R];
+                std::stable_sort(id.begin(), id.end(), [&](int x, int y) { return L[x] > L[y]; });
+                double mx = *std::max_element(L, L + NEXP_R), z = 0;
+                for (int e = 0; e < NEXP_R; ++e) z += std::exp((double)L[e] - mx);
+                double top = 0;
+                for (int k = 0; k < TOPK; ++k) top += std::exp((double)L[id[k]] - mx) / z;
+                for (int k = 0; k <= TOPK; ++k)
+                {
+                    const int e = k < TOPK ? id[k] : NEXP_R;
+                    const double w = k < TOPK ? std::exp((double)L[e] - mx) / z / (top + 1e-20) : 1.0;
+                    const int s = P.tok_slot[m][k], c = P.tok_col[m][k];
+                    if (P.tok_expert[m][k] != e || std::fabs(P.tok_w[m][k] - w) > 1e-6 || s < 0 || P.slot_expert[s] != e ||
+                        P.slot_tok[s][c] != m || std::fabs(P.slot_w[s][c] - P.tok_w[m][k]) != 0 || !(P.slot_mask[s] >> c & 1))
+                    {
+                        if (bad++ < 5) fprintf(stderr, "M %d trial %d token %d route %d: expert %d (want %d) w %.8f (want %.8f) slot %d col %d\n",
+                                               M, trial, m, k, P.tok_expert[m][k], e, P.tok_w[m][k], w, s, c);
+                    }
+                    ++cnt[e];
+                }
+                for (int k = TOPK + 1; k < 8; ++k) if (P.tok_slot[m][k] != -1) ++bad;
+            }
+            for (int e = 0; e < NEXP; ++e) nslot_ref += M > 8 ? (cnt[e] + 7) / 8 : (cnt[e] > 0);
+            if (P.n_slots != nslot_ref) { if (bad++ < 5) fprintf(stderr, "M %d: n_slots %d want %d\n", M, P.n_slots, nslot_ref); }
+            for (int s = 1; s < P.n_slots; ++s) if (P.slot_expert[s] < P.slot_expert[s - 1]) ++bad;
+        }
+    printf("router_ml4: %s (%d mismatches)\n", bad ? "FAIL" : "PASS", bad);
+    return bad ? 1 : 0;
+}
