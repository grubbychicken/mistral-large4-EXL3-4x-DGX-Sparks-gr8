+        const int v = __shfl_up_sync(0xffffffffu, scan, o);
+        if (l >= o) scan += v;
+    }
+    if (l == 31) wcount[w] = scan;
+    __syncthreads();
+    int base = 0;
+    #pragma unroll
+    for (int i = 0; i < ML4_RT / 32; ++i) if (i < w) base += wcount[i];
+    const int slot0 = base + scan - nsl;
+    if (nsl)
+    {
+        slot_of[t] = slot0;
+        const int cnt = __popc(em);
+        for (int j = 0; j < nsl; ++j)
+        {
+            P->slot_expert[slot0 + j] = t;
+            P->slot_mask[slot0 + j] = dense ? static_cast<int>((1u << (cnt - 8 * j < 8 ? cnt - 8 * j : 8)) - 1u) : static_cast<int>(em);
+        }
+    }
+    if (t == 0)
+    {
+        int n = 0;
+        #pragma unroll
+        for (int i = 0; i < ML4_RT / 32; ++i) n += wcount[i];
+        P->n_slots = n;
+    }
+    __syncthreads();
+    for (int i = t; i < M * ML4_K; i += ML4_RT)
+    {
+        const int m = i / ML4_K, k = i % ML4_K;
+        const int e = sel_e[m][k];
+        const int r = __popc(emask[e] & ((1u << m) - 1u));      // rank of token m among the expert's tokens
+        const int s2 = slot_of[e] + (dense ? r >> 3 : 0), col = dense ? (r & 7) : m;
+        P->tok_slot[m][k] = s2;
+        P->tok_col[m][k] = col;
+        P->tok_w[m][k] = sel_w[m][k];
+        P->tok_expert[m][k] = e;
+        P->slot_w[s2][col] = sel_w[m][k];
+        P->slot_tok[s2][col] = m;
+    }
+}
+#endif
