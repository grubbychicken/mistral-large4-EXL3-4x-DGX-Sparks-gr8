@@ -3054,14 +3077,18 @@ __global__ void __launch_bounds__(256, 2) k_pf_fc1(Expert A)
     const int* sg = A.segs + static_cast<size_t>(seg) * 3;
     const int r0 = sg[1], rows = sg[2];
