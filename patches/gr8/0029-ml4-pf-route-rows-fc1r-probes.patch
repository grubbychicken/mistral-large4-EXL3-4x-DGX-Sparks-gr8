-template <int EB = g6nr::EB, bool K2 = false, bool BS = false, bool AOPK = false PF_H16P, int CB = TR3_MCG>
+// RX: grid (EB, maxseg), the matrix is A.rmat (rx holds one matrix)
+template <int EB = g6nr::EB, bool K2 = false, bool BS = false, bool AOPK = false PF_H16P, int CB = TR3_MCG, bool RX = false>
 __global__ void __launch_bounds__(256, 2) k_pf_fc1(Expert A)
 {
