@@ -3094,15 +3121,15 @@ __global__ void __launch_bounds__(256, 2) k_pf_fc1(Expert A)
 #endif
     if (rows <= 32)                       // G = 2: two 128-k blocks per group
     {
-        if (k == 3) fc1_body<3, 2, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
-        else if (!K2 || k == 4) fc1_body<4, 2, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
-        else fc1_body<K2 ? 2 : 4, 2, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        if (k == 3) fc1_body<3, 2, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        else if (!K2 || k == 4) fc1_body<4, 2, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        else fc1_body<K2 ? 2 : 4, 2, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
     }
     else
     {
-        if (k == 3) fc1_body<3, 1, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
-        else if (!K2 || k == 4) fc1_body<4, 1, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
-        else fc1_body<K2 ? 2 : 4, 1, EB, 1, BS PF_H16A>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        if (k == 3) fc1_body<3, 1, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        else if (!K2 || k == 4) fc1_body<4, 1, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
+        else fc1_body<K2 ? 2 : 4, 1, EB, 1, BS PF_H16A, RX>(A, tr, b, mat, r0, rows, sA, sX, sW, sRow PF_PRO_CALL, mw);
     }
 #ifdef PF_CLK
     pf_clk_end(true);
@@ -3477,6 +3504,54 @@ __global__ void __launch_bounds__(256) k_pf_hx(Expert A)
         *reinterpret_cast<uint4*>(o + j * 8) = u;
     }
 }
+// rx[i] = f16(H128(x[rr_row[i]] * suh)) of route i for matrix A.rmat, suh = the t_v1 row of (the route's expert, block 0,
+// rmat): the fc1_body prologue's lane code, so rx holds the bytes the prologue writes into the fc1 stage. The blocks of
+// one expert on a rank carry the same suh row (one input rotation per weight matrix; fc1_body's "lead block" premise).
+// warp = (8 routes, 128-k block), lane = (route lane / 4, k32 step lane % 4). grid ceil(ceil(nroutes / 8) * HID / 128 / 8), block 256
+__global__ void __launch_bounds__(256) k_pf_rot(Expert A)
+{
+    constexpr int NB = HID / 128;
+    const int w = (blockIdx.x * 256 + threadIdx.x) >> 5, lane = threadIdx.x & 31;
+    const int rb = w / NB, kb = w - rb * NB, i = rb * 8 + (lane >> 2), q = lane & 3;
+    const int n = A.nroutes;
+    if (rb * 8 >= n) return;                     // warp-uniform
+    const bool on = i < n;
+    const int ii = on ? i : n - 1;
+    const long long* tr = A.t_tab + static_cast<size_t>(A.rr_e[ii]) * 6;
+    const __half* xr = A.x + static_cast<size_t>(A.rr_row[ii]) * A.ldx + kb * 128 + q * 32;
+    const __half* sp = A.t_v1 + (static_cast<size_t>(tr[2]) * 2 + A.rmat) * HID + kb * 128 + q * 32;
+    float v[32];
+    #pragma unroll
+    for (int j = 0; j < 4; ++j)
+    {
+        const uint4 xv = on ? *reinterpret_cast<const uint4*>(xr + j * 8) : make_uint4(0u, 0u, 0u, 0u);
+        const uint4 sv = *reinterpret_cast<const uint4*>(sp + j * 8);
+        const u32 xw[4] = {xv.x, xv.y, xv.z, xv.w}, sw[4] = {sv.x, sv.y, sv.z, sv.w};
+        #pragma unroll
+        for (int e = 0; e < 4; ++e)
+        {
+            const float2 x2 = __half22float2(as_h2(xw[e])), s2 = __half22float2(as_h2(sw[e]));
+            v[j * 8 + e * 2] = __fmul_rn(x2.x, s2.x);
+            v[j * 8 + e * 2 + 1] = __fmul_rn(x2.y, s2.y);
+        }
+    }
+    had128_l32(v, lane);
+    if (!on) return;
+    __half* o = A.rx + static_cast<size_t>(i) * HID + kb * 128 + q * 32;
+    #pragma unroll
+    for (int j = 0; j < 4; ++j)
+    {
+        uint4 u;
+        u.x = pack_h2(v[j * 8], v[j * 8 + 1]); u.y = pack_h2(v[j * 8 + 2], v[j * 8 + 3]);
+        u.z = pack_h2(v[j * 8 + 4], v[j * 8 + 5]); u.w = pack_h2(v[j * 8 + 6], v[j * 8 + 7]);
+        *reinterpret_cast<uint4*>(o + j * 8) = u;
+    }
+}
+inline void launch_rot(const Expert& A, cudaStream_t st)       // per matrix (A.rmat), before its fc1 launch
+{
+    const long long warps = static_cast<long long>((A.nroutes + 7) / 8) * (HID / 128);
+    k_pf_rot<<<static_cast<unsigned>((warps + 7) / 8), 256, 0, st>>>(A);
+}
 __global__ void __launch_bounds__(256) k_pf_hxq(Expert A);       // PF_Q8, below
 __global__ void __launch_bounds__(256) k_pf_hxqf(Expert A);      // GR8_PF_HXF, below
 inline void launch_hx(const Expert& A, cudaStream_t st)     // once per layer, before the shared and the routed fc1
@@ -4130,6 +4205,201 @@ template <int EB = g6nr::EB, int CB = TR3_MCG> inline void launch_fc1w(const Exp
     k_pf_fc1w<EB, CB><<<dim3(2 * EB, pass_wtiles(A)), 512, WM_SMEM, st>>>(A);
 #endif
 }
+#if G6_MODEL_ML4
+// Weight-major fc1 on route rows (Expert::rxk = 2, ML4_PF_RX=2): k_pf_fc1ws's CTA for layers without block scales whose
+// K3 units are in the wide order (ML4 with --wide). CTA = (wtile = up to WM_R consecutive routes of one expert, block b),
+// matrix A.rmat; 384 threads. A = the tile's rx rows (k_pf_rot: already rotated, read by route index, nothing to scale).
+// Producer warp p (0-3) copies A chunks by cp.async and decodes col tiles 2p, 2p + 1: per 128-k group it holds the lane's
+// 2 x 3 u64 of the wide order (ld_nc64, one group ahead, as fc1_body), per k32 step s it decodes chunks 2s and 2s + 1 of
+// both (the 13 bits before a chunk from lane - 1, decode_m as fc1_body's wide path) into sB slot (kk * 8 + col tile).
+// Consumer warp (wr, wc): cols wc * 32 .. + 31, the row blocks of its half of the tile's ceil(rows / 16) (wr = 0 the first
+// ceil(n / 2), so a short tile keeps all 8 consumer warps busy). Every acc sums the k16 steps in increasing order with
+// fc1_body's H16 fragments: z1 is byte-equal to k_pf_fc1. A weight group is read and decoded once per wtile.
+#ifndef PF_RA_NA
+#define PF_RA_NA 5
+#endif
+constexpr int RA_NA = PF_RA_NA;                // A stages (rx rows come from DRAM: a longer cp.async lookahead than fc1ws; 5 = 96 KB of the Spark's 99 KB of smem per CTA)
+constexpr int RA_LA = RA_NA - WS_NB;           // A cp.async lookahead
+static_assert(RA_LA >= 1, "fc1r rings");
+constexpr int RA_SMEM = RA_NA * WM_SA + WS_NB * WM_SB;
+template <int NMW>
+__device__ __forceinline__ void fc1r_cons(float (&acc)[8][4][4], const unsigned char* sA, const unsigned char* sB, int rb0, int wc, int lane)
+{
+    constexpr int NK = KSH / 2, NT = 384;
+    for (int k = 0; k < NK; ++k)
+    {
+        nb_sync(1 + k % WS_NB, NT);
+        const unsigned char* a = sA + (k % RA_NA) * WM_SA;
+        const unsigned char* bb = sB + (k % WS_NB) * WM_SB;
+        if (NMW > 0)
+        {
+            #pragma unroll
+            for (int kk = 0; kk < 2; ++kk)
+            {
+                const uint4 f0 = *reinterpret_cast<const uint4*>(bb + (kk * 8 + wc * 2) * 512 + lane * 16);
+                const uint4 f1 = *reinterpret_cast<const uint4*>(bb + (kk * 8 + wc * 2 + 1) * 512 + lane * 16);
+                const int ch = 2 * kk + (lane >> 4);
+                auto lda = [&](u32 (&av)[4], int mb) {
+                    const int Rl = (rb0 + mb) * 16 + (lane & 15);
+                    pf_ldsm4(av, a + Rl * 64 + ((ch ^ ((Rl >> 1) & 3)) << 4));
+                };
+                u32 av[2][4];
+                lda(av[0], 0);
+                #pragma unroll
+                for (int mb = 0; mb < NMW; ++mb)
+                {
+                    if (mb + 1 < NMW) lda(av[(mb + 1) & 1], mb + 1);
+                    const u32* q = av[mb & 1];
+                    mma16816(acc[mb][0], q[0], q[1], q[2], q[3], f0.x, f0.y);
+                    mma16816(acc[mb][1], q[0], q[1], q[2], q[3], f0.z, f0.w);
+                    mma16816(acc[mb][2], q[0], q[1], q[2], q[3], f1.x, f1.y);
+                    mma16816(acc[mb][3], q[0], q[1], q[2], q[3], f1.z, f1.w);
+                }
+            }
+        }
+        if (k + WS_NB < NK) nb_arrive(1 + WS_NB + k % WS_NB, NT);
+    }
+}
+template <int EB, int CB>
+__device__ __forceinline__ void fc1r_body(const Expert& A, int b, int mat, int r0, int rows, const uint8_t* mw, unsigned char* sm)
+{
+    constexpr int NK = KSH / 2, NT = 384, NB = HID / 128;
+    unsigned char* sA = sm;
+    unsigned char* sB = sA + RA_NA * WM_SA;
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    if (warp < 4)
+    {
+        // producer: thread t copies A chunks c = t + 128 i (row c / 4, k chunk c % 4 of the k32 step)
+        u32 gx[8];
+        #pragma unroll
+        for (int i = 0; i < 8; ++i)
+        {
+            const int c = t + 128 * i, R = c >> 2;
+            gx[i] = R < rows ? static_cast<u32>(r0 + R) * static_cast<u32>(HID) + static_cast<u32>((c & 3) * 8) : 0xffffffffu;
+        }
+        auto soff = [&](int i) { const int c = t + 128 * i, R = c >> 2; return R * 64 + (((c & 3) ^ ((R >> 1) & 3)) << 4); };
+        auto stage_a = [&](int k) {
+            unsigned char* a = sA + (k % RA_NA) * WM_SA;
+            #pragma unroll
+            for (int i = 0; i < 8; ++i)
+                if (gx[i] != 0xffffffffu) pf::cp16(a + soff(i), A.rx + (gx[i] + static_cast<u32>(k * 32)));
+        };
+        // the lane's u64 n of col tile 2 warp + jj in group hb: mw + hb * TR3W_GROUP + (n * 8 + tile) * 256 + lane * 8
+        const uint8_t* wg = mw + static_cast<size_t>(2 * warp) * 256 + lane * 8;
+        u64 nw[2][3], cw[2][3];
+        #pragma unroll
+        for (int jj = 0; jj < 2; ++jj)
+            #pragma unroll
+            for (int n = 0; n < 3; ++n) { nw[jj][n] = ld_nc64(wg + jj * 256 + n * 2048); cw[jj][n] = 0; }
+        #pragma unroll
+        for (int k = 0; k < RA_LA; ++k)
+        {
+            stage_a(k);
+            pf::cp_commit();
+        }
+        for (int j = 0; j < NK; ++j)
+        {
+            // consumers done with step j - WS_NB: B stage j % WS_NB and A stage (j + RA_LA) % RA_NA are free
+            if (j >= WS_NB) nb_sync(1 + WS_NB + j % WS_NB, NT);
+            if (j + RA_LA < NK) stage_a(j + RA_LA);
+            pf::cp_commit();
+            pf::cp_wait<RA_LA>();
+            const int s = j & 3, hb = j >> 2;
+            if (s == 0)
+            {
+                #pragma unroll
+                for (int jj = 0; jj < 2; ++jj)
+                    #pragma unroll
+                    for (int n = 0; n < 3; ++n)
+                    {
+                        cw[jj][n] = nw[jj][n];
+                        if (hb + 1 < NB) nw[jj][n] = ld_nc64(wg + static_cast<size_t>(hb + 1) * TR3W_GROUP + jj * 256 + n * 2048);
+                    }
+            }
+            #pragma unroll
+            for (int jj = 0; jj < 2; ++jj)
+                #pragma unroll
+                for (int kk = 0; kk < 2; ++kk)
+                {
+                    const u32 c = trw_chunk<3>(cw[jj], 2 * s + kk);
+                    const u32 pc = __shfl_sync(0xffffffffu, c, (lane + 31) & 31);
+                    u32 f0[2], f1[2];
+                    Tr3Lane<3, false, CB>::decode_m((static_cast<u64>(pc) << 24) | c, 21, f0, f1);
+                    if (A.e4) { f0[0] = pf_e4r(f0[0]); f0[1] = pf_e4r(f0[1]); f1[0] = pf_e4r(f1[0]); f1[1] = pf_e4r(f1[1]); }
+                    *reinterpret_cast<uint4*>(sB + (j % WS_NB) * WM_SB + (kk * 8 + 2 * warp + jj) * 512 + lane * 16) = make_uint4(f0[0], f0[1], f1[0], f1[1]);
+                }
+            nb_arrive(1 + j % WS_NB, NT);
+        }
+        return;
+    }
+    const int cwp = warp - 4, wr = cwp >> 2, wc = cwp & 3;
+    const int nrb = (rows + 15) / 16, h = (nrb + 1) / 2;
+    const int rb0 = wr ? h : 0, nmw = wr ? nrb - h : h;       // the warp's row blocks (warp-uniform)
+    float acc[8][4][4];
+    #pragma unroll
+    for (int mb = 0; mb < 8; ++mb)
+        #pragma unroll
+        for (int n = 0; n < 4; ++n)
+            #pragma unroll
+            for (int i = 0; i < 4; ++i) acc[mb][n][i] = 0.f;
+    switch (nmw)
+    {
