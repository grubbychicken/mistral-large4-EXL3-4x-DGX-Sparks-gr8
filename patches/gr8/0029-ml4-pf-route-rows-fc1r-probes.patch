-    if (threadIdx.x < rows) sRow[threadIdx.x] = A.rr_row[r0 + threadIdx.x];
+    if (threadIdx.x < rows) sRow[threadIdx.x] = RX ? r0 + threadIdx.x : A.rr_row[r0 + threadIdx.x];
     __syncthreads();
 #ifdef PF_SKIPPRO
