+#if G6_PF_H16
+    const int mat = RX ? A.rmat : blockIdx.x / EB, b = RX ? blockIdx.x : blockIdx.x - mat * EB;     // x = mat * EB + b: the EB blocks of one (segment, matrix) are adjacent on x (cluster-able)
