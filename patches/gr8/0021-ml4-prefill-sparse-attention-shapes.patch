+// GR8_PF_USTAT: blocks of BR rows -> out[0] += the distinct valid keys of their selections, out[1] += the rows' valid keys
+__global__ void union_count(G6Attn a,int start,int n,int BR,unsigned long long* out){
+    extern __shared__ unsigned bits[];const int words=(a.context+31)/32,r0=blockIdx.x*BR,r1=min(n,r0+BR);__shared__ unsigned tot[2];
+    if(threadIdx.x<2)tot[threadIdx.x]=0;for(int i=threadIdx.x;i<words;i+=blockDim.x)bits[i]=0;__syncthreads();unsigned v=0,u=0;
+    for(int i=threadIdx.x;i<(r1-r0)*TOP;i+=blockDim.x){const int r=start+r0+i/TOP,id=a.indices[(int64_t)r*TOP+i%TOP];if(id>=0&&id<=a.positions[r]&&id<a.context){atomicOr(&bits[id>>5],1u<<(id&31));v++;}}
+    __syncthreads();for(int i=threadIdx.x;i<words;i+=blockDim.x)u+=__popc(bits[i]);atomicAdd(&tot[0],u);atomicAdd(&tot[1],v);__syncthreads();
+    if(threadIdx.x==0){atomicAdd(out,(unsigned long long)tot[0]);atomicAdd(out+1,(unsigned long long)tot[1]);}
+}
