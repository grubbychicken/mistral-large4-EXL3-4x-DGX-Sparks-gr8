+// The sparse path, each output element computed as sparse_qk / normalize / sparse_pv do (same operands, same
+// accumulation order: same bits), in shapes that keep more gathers in flight (GR8_PF_SQK / GR8_PF_SPV; 28K prefill,
+// 1,152 sparse calls: scores 4.85 -> 3.96 s, normalize 1.33 -> 0.93, values 6.12 -> 3.94).
+// normalize's arithmetic (same reductions), the probabilities rounded to half (as sparse_pv's operand load rounds them)
+// in place: row-head i's halves are the first TOP*2 bytes of its fp32 scores
+__global__ void __launch_bounds__(256) normalize_h(G6Attn a,float* scores){
+    int i=blockIdx.x,t=threadIdx.x;float* p=scores+(int64_t)i*ga::TOP;__shared__ float tmp[8],mx,den;constexpr int J=ga::TOP/256;float v[J];
+    float m=-INFINITY;
+#pragma unroll
+    for(int u=0;u<J;u++){v[u]=p[t+u*256];m=fmaxf(m,v[u]);}m=ga::warp_max(m);if((t&31)==0)tmp[t/32]=m;__syncthreads();
+    if(t==0){mx=-INFINITY;for(int j=0;j<8;j++)mx=fmaxf(mx,tmp[j]);}__syncthreads();
+    float s=0;
+#pragma unroll
+    for(int u=0;u<J;u++){v[u]=isfinite(mx)?expf(v[u]-mx):0;s+=v[u];}s=ga::warp_sum(s);if((t&31)==0)tmp[t/32]=s;__syncthreads();
+    if(t==0){den=0;for(int j=0;j<8;j++)den+=tmp[j];if(den==0)ga::error(a,16);}__syncthreads();
+    half* o=(half*)p;
+#pragma unroll
+    for(int u=0;u<J;u++)o[t+u*256]=__float2half_rn(den>0?v[u]/den:0);
+}
+// sparse_pv on normalize_h's half probabilities, N context columns a CTA (128: each probability row read 4 times, not 8),
+// K selected keys a staging (the MMA still steps 16 keys at a time in list order)
+template<int MT,int N,int K> __global__ void __launch_bounds__(N*2) sparse_pv_h(G6Attn a,int start,int R,const float* p,const half* cache,float* context){
+ using namespace nvcuda;constexpr int THREADS=N/16*32;int row=blockIdx.y,r=start+row,d0=blockIdx.x*N,t=threadIdx.x,w=t/32;
+ const int hn=min(16*MT,a.heads);
+ constexpr int ARENA=(16*MT+N)*K>16*MT*N*2?(16*MT+N)*K:16*MT*N*2;   // the fp32 output tile reuses it
+ __shared__ __align__(32) half arena[ARENA];half* A=arena;half* B=A+16*MT*K;float* O=(float*)arena;
+ wmma::fragment<wmma::matrix_a,16,16,16,half,wmma::row_major>aa;
+ wmma::fragment<wmma::matrix_b,16,16,16,half,wmma::row_major>bb;
+ wmma::fragment<wmma::accumulator,16,16,16,float>cc[MT];
+#pragma unroll
+ for(int m=0;m<MT;m++)wmma::fill_fragment(cc[m],0.f);
+ for(int base=0;base<ga::TOP;base+=K){
+  for(int i=t;i<16*MT*K/8;i+=THREADS){int h=i/(K/8),j=base+(i%(K/8))*8;((int4*)A)[i]=h<a.heads?*(const int4*)((const half*)(p+((int64_t)row*a.heads+h)*ga::TOP)+j):make_int4(0,0,0,0);}
+  for(int i=t;i<K*N/8;i+=THREADS){int j=base+i/(N/8),d=d0+(i%(N/8))*8,id=a.indices[(int64_t)r*ga::TOP+j];bool ok=id>=0&&id<=a.positions[r]&&id<a.context;((int4*)B)[i]=ok?*(const int4*)(cache+(int64_t)id*576+d):make_int4(0,0,0,0);}
+  __syncthreads();for(int k=0;k<K;k+=16){wmma::load_matrix_sync(bb,B+k*N+w*16,N);
+#pragma unroll
+   for(int m=0;m<MT;m++){wmma::load_matrix_sync(aa,A+m*16*K+k,K);wmma::mma_sync(cc[m],aa,bb,cc[m]);}}__syncthreads();
+ }
+#pragma unroll
+ for(int m=0;m<MT;m++)wmma::store_matrix_sync(O+m*16*N+w*16,cc[m],N,wmma::mem_row_major);__syncthreads();for(int i=t;i<hn*N;i+=THREADS){int h=i/N,d=i%N;context[((int64_t)h*R+row)*512+d0+d]=O[i];}
+}
+// sparse_qk with N selected keys a CTA, staged K dims at a time (the MMA still steps 16 dims in order: same bits)
+template<int MT,int N,int K> __global__ void __launch_bounds__(N*2) sparse_qk_v(G6Attn a,int start,int R,const half* q,const half* cache,float* scores){
+ using namespace nvcuda;constexpr int THREADS=N/16*32;int row=blockIdx.y,r=start+row,k0=blockIdx.x*N,t=threadIdx.x,w=t/32;
+ const int hn=min(16*MT,a.heads);
+ constexpr int ARENA=(16*MT+N)*K>16*MT*N*2?(16*MT+N)*K:16*MT*N*2;
+ __shared__ __align__(32) half arena[ARENA];half* A=arena;half* B=A+16*MT*K;float* O=(float*)arena;
+ wmma::fragment<wmma::matrix_a,16,16,16,half,wmma::row_major>aa;
+ wmma::fragment<wmma::matrix_b,16,16,16,half,wmma::col_major>bb;
+ wmma::fragment<wmma::accumulator,16,16,16,float>cc[MT];
+#pragma unroll
+ for(int m=0;m<MT;m++)wmma::fill_fragment(cc[m],0.f);
+ for(int base=0;base<576;base+=K){
+  for(int i=t;i<16*MT*K/8;i+=THREADS){int h=i/(K/8),d=base+(i%(K/8))*8;((int4*)A)[i]=(h<a.heads&&d<576)?*(const int4*)(q+((int64_t)h*R+row)*576+d):make_int4(0,0,0,0);}
+  for(int i=t;i<N*K/8;i+=THREADS){int j=i/(K/8),d=base+(i%(K/8))*8,id=a.indices[(int64_t)r*ga::TOP+k0+j];bool ok=id>=0&&id<=a.positions[r]&&id<a.context&&d<576;((int4*)B)[i]=ok?*(const int4*)(cache+(int64_t)id*576+d):make_int4(0,0,0,0);}
+  __syncthreads();for(int k=0;k<K;k+=16){wmma::load_matrix_sync(bb,B+w*16*K+k,K);
+#pragma unroll
+   for(int m=0;m<MT;m++){wmma::load_matrix_sync(aa,A+m*16*K+k,K);wmma::mma_sync(cc[m],aa,bb,cc[m]);}}__syncthreads();
+ }
+#pragma unroll
+ for(int m=0;m<MT;m++)wmma::store_matrix_sync(O+m*16*N+w*16,cc[m],N,wmma::mem_row_major);__syncthreads();
+ for(int i=t;i<hn*N;i+=THREADS){int h=i/N,j=i%N,id=a.indices[(int64_t)r*ga::TOP+k0+j];bool ok=id>=0&&id<=a.positions[r]&&id<a.context;scores[((int64_t)row*a.heads+h)*ga::TOP+k0+j]=ok?O[i]*(1.f/16):-INFINITY;}
+}
