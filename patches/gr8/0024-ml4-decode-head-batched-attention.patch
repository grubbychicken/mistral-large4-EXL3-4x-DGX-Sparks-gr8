--- a/engine/attn/decode-small.cuh
+++ b/engine/attn/decode-small.cuh
@@ -631,8 +631,10 @@ static void launch_context_tile(const G6Attn& a,Input input,Work& w,int start,in
 // index and contexts past 2048 included.
 template<class Input>   // qt: run_body only (attn.cu use_qt, which implies the scores_sc branch below)
 static void launch_mla_scores(const G6Attn& a,Input input,Work& w,int start,int n,cudaStream_t st,bool qt=false){
- #if G6_MODEL_ML4   // the FP16 ML4 row (kvfmt.h): the generic kernel (latent() / rope_key()); the FP8 variants below read E4M3
- (void)qt;mla_scores<<<dim3(TOP/8,a.heads,n),256,0,st>>>(input,start,w.q,w.rope,w.prob);
+ #if G6_MODEL_ML4   // the FP16 ML4 row (kvfmt.h): its head-batched kernel (ml4-decode.cuh), or the generic one; the FP8 variants below read E4M3
+ (void)qt;
+ if(attn_heads()){constexpr int HG=16;ml4dec::scores_heads<HG><<<dim3(TOP/8,(a.heads+HG-1)/HG,n),256,0,st>>>(input,start,w.q,w.rope,w.prob);}
+ else mla_scores<<<dim3(TOP/8,a.heads,n),256,0,st>>>(input,start,w.q,w.rope,w.prob);
