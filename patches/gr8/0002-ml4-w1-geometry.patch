+"""engine/model_geom_ml4.h against the pack's config.json (engine/ref/ml4/config.json: the text_config of the EXL3 3.0 bpw
+pack of mistralai/Mistral-Large-4-1T-A52B, sha256 below).
+ML4_GEOM_DUMP=<binary built from ml4_geom_dump.cpp> python3 -m unittest -q test_ml4_geom   (scripts/host_tests.sh)"""
+import hashlib
+import json
+import os
+import subprocess
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+CONFIG = os.path.join(HERE, '..', 'ref', 'ml4', 'config.json')
+CONFIG_SHA256 = open(CONFIG + '.sha256').read().split()[0] if os.path.exists(CONFIG + '.sha256') else None
+
+
+def dump():
+    out = subprocess.run([os.environ['ML4_GEOM_DUMP']], check=True, capture_output=True, text=True).stdout
+    scalars, layers = {}, {}
+    for line in out.splitlines():
+        f = line.split()
+        if f[0] == 'layer':
+            layers[int(f[1])] = dict(zip(f[2::2], map(int, f[3::2])))
+        else:
+            scalars[f[0]] = float(f[1])
+    return scalars, layers
+
+
+class Ml4Geom(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        with open(CONFIG, 'rb') as fh:
+            raw = fh.read()
+        cls.sha = hashlib.sha256(raw).hexdigest()
+        cls.cfg = json.loads(raw)
+        cls.t = cls.cfg.get('text_config', cls.cfg)
+        cls.g, cls.layers = dump()
+
+    def test_config_is_the_pack(self):
+        if CONFIG_SHA256:
+            self.assertEqual(self.sha, CONFIG_SHA256)
+        self.assertEqual(self.cfg['architectures'], ['MistralLarge4ForConditionalGeneration'])
+        self.assertEqual(self.cfg['quantization_config']['codebook'], 'mul1')
+
+    def test_scalars_equal_config(self):
+        t, g = self.t, self.g
+        pairs = {
+            'HID': 'hidden_size', 'VOCAB': 'vocab_size', 'L_MAIN': 'num_hidden_layers', 'RMS_EPS': 'rms_norm_eps',
+            'SOFTCAP': 'final_logit_softcapping', 'NEXP_ROUTED': 'n_routed_experts', 'TOPK': 'num_experts_per_tok',
+            'EXP_I': 'moe_intermediate_size', 'DENSE_I': 'intermediate_size', 'ROUTE_SCALE': 'routed_scaling_factor',
+            'HEADS': 'num_attention_heads', 'KV_LORA': 'kv_lora_rank', 'QK_ROPE': 'qk_rope_head_dim',
+            'ML4_QK_HEAD': 'qk_head_dim', 'ML4_QK_NOPE': 'qk_nope_head_dim', 'ML4_V_HEAD': 'v_head_dim',
+            'MAX_POS': 'max_position_embeddings', 'IDX_HEADS': 'index_n_heads', 'IDX_DIM': 'index_head_dim',
+            'IDX_TOPK': 'index_topk', 'TOK_BOS': 'bos_token_id', 'TOK_EOS': 'eos_token_id',
+        }
+        for name, key in pairs.items():
+            self.assertAlmostEqual(g[name], float(t[key]), delta=abs(float(t[key])) * 1e-6, msg=f'{name} vs {key}')
+        r = t['rope_parameters']
+        self.assertEqual(r['rope_type'], 'yarn')
+        self.assertEqual(float(r.get('attention_factor', 1.0)), 1.0)
+        self.assertEqual((g['ROPE_THETA'], g['YARN_FACTOR'], g['YARN_ORIG_POS'], g['YARN_BETA_FAST'], g['YARN_BETA_SLOW']),
+                         tuple(float(r[k]) for k in ('rope_theta', 'factor', 'original_max_position_embeddings',
+                                                    'beta_fast', 'beta_slow')))
+        self.assertEqual(g['HEAD_BITS'], float(self.cfg['quantization_config']['head_bits']))
+        self.assertEqual(t['first_k_dense_replace'], 1)
+        self.assertEqual((t['n_group'], t['topk_group'], t['n_shared_experts']), (1, 1, 1))
+
+    def test_layer_tables_equal_config(self):
+        t = self.t
+        self.assertEqual(len(self.layers), t['num_hidden_layers'])
+        for l, v in self.layers.items():
+            self.assertEqual(v['rope'], t['no_rope_layers'][l], f'layer {l} rope')
+            self.assertEqual(v['kv_src'], t['kv_source_layers'][l], f'layer {l} kv_src')
+            self.assertEqual(v['full_index'], int(t['indexer_types'][l] == 'full'), f'layer {l} indexer')
+            self.assertEqual(v['moe'], int(t['mlp_layer_types'][l] == 'sparse'), f'layer {l} mlp')
+
+
+if __name__ == '__main__':
+    unittest.main()
