+// Prints the Mistral Large 4 geometry (engine/model_geom_ml4.h) as "name value" lines for test_ml4_geom.py to compare
+// with engine/ref/ml4/config.json. Build: g++ -std=c++17 -DG6_MODEL_ML4=1 -I engine ml4_geom_dump.cpp
+#include <cstdio>
+#include "model_geom.h"
+#define P(n) std::printf("%s %.9g\n", #n, (double)geom::n)
+int main()
+{
+    P(HID); P(VOCAB); P(VTILES); P(KSH); P(HB); P(L_MAIN); P(MTP_LAYER); P(NLAYERS); P(RMS_EPS); P(LN_EPS); P(SOFTCAP);
+    P(HEAD_BITS); P(NEXP_ROUTED); P(TOPK); P(EXP_I); P(EXP_BLOCKS); P(DENSE_I); P(ROUTE_SCALE); P(HEADS); P(KV_LORA);
+    P(QK_ROPE); P(KVA); P(ML4_QK_HEAD); P(ML4_QK_NOPE); P(ML4_QK_NOPE_NR); P(ML4_V_HEAD); P(ML4_Q_OUT); P(ML4_O_IN);
+    P(ML4_KVA_ROWS); P(ROPE_THETA); P(YARN_FACTOR); P(YARN_ORIG_POS); P(YARN_BETA_FAST); P(YARN_BETA_SLOW); P(MAX_POS);
+    P(IDX_HEADS); P(IDX_DIM); P(IDX_TOPK); P(ML4_IDXQ); P(TOK_BOS); P(TOK_EOS);
+    for (int l = 0; l < geom::L_MAIN; ++l)
+        std::printf("layer %d rope %d kv_src %d full_index %d moe %d\n", l, (int)geom::rope(l), geom::kv_src(l),
+                    (int)geom::full_index(l), (int)geom::is_moe(l));
+    return 0;
+}
