diff --git a/engine/model_geom_ml4.h b/engine/model_geom_ml4.h
index 41df15e..bc1df26 100644
--- a/engine/model_geom_ml4.h
+++ b/engine/model_geom_ml4.h
@@ -1,45 +1,94 @@
-// Mistral Large 4 geometry (-DG6_MODEL_ML4=1), included by model_geom.h. STAGE: K1 (decode MoE) bench only.
-// The MoE names carry Mistral Large 4's values (config.json of mistralai/Mistral-Large-4-1T-A52B @ af26e786):
-//   hidden_size 6144, n_routed_experts 128, num_experts_per_tok 4, moe_intermediate_size 6144, layer-0 dense FFN 24576,
-//   routed_scaling_factor 1.0, vocab 204800, 72 layers, DSA indexer 32 x 128 top-2048, kv_lora_rank 512, rope 64.
-// The attention names below that ML4 does not share with GLM (QA: ML4 has no q-LoRA; V_HEAD 128; QK_NOPE 64; the
-// DFlash2 drafter sizes) are GLM PLACEHOLDERS so bind.cuh compiles; nothing in the K1 bench reads them. The ML4 port
-// replaces them with its own attention path.
-// ML4_BENCH_NEXP (default 128): 129 makes row 128 a routed row the bench uses for the shared expert (routed to every
-// token with weight 1), because ML4's EXL3 shared expert has per-channel vectors and cannot be gr8's block-scale
-// trellis shared expert (tr3.table row NEXP).
+// Mistral Large 4 geometry (-DG6_MODEL_ML4=1), included by model_geom.h. Card: the recipe's docs/PORT.md section 1.
+// Every value is checked against the pack's config.json (Mistral-Large-4-1T-A52B-EXL3-3.0bpw, the text_config of
+// mistralai/Mistral-Large-4-1T-A52B @ af26e786) by engine/tests/test_ml4_geom.py, and the per-layer tables by the
+// static_asserts at the end.
+//   [cfg]   the config.json field of the same meaning
+//   [shape] read off the pack's safetensors headers
+//   [der]   derived, as the comment says
+// The names GLM code already uses keep their meaning where ML4 has the same thing (HID, NEXP, TOPK, HEADS, KV_LORA,
+// QK_ROPE, KVA, IDX_*, VOCAB, ...). ML4's own attention widths are the ML4_* names; the GLM names QA, QK_NOPE, V_HEAD
+// and DFL_* stay GLM PLACEHOLDERS until the ML4 attention path (docs/PORT.md W5) stops reading them.
+// ML4_BENCH_NEXP (default 128): 129 makes row 128 a routed row carrying the shared expert (routed to every token with
+// weight 1), because ML4's EXL3 shared expert has per-channel vectors and cannot be gr8's block-scale trellis shared
+// expert (tr3.table row NEXP). The P3b K1 bench and the port use it.
 #pragma once
 #ifndef ML4_BENCH_NEXP
 #define ML4_BENCH_NEXP 128
 #endif
 namespace geom
 {
+// --- trunk ---
 constexpr int HID = 6144;            // [cfg] hidden_size
-constexpr int NEXP = ML4_BENCH_NEXP; // [cfg] n_routed_experts 128 (+1 bench row, see above)
-constexpr int TOPK = 4;              // [cfg] num_experts_per_tok
-constexpr int EXP_I = 6144;          // [cfg] moe_intermediate_size
-constexpr int EXP_BLOCKS = EXP_I / 128;   // 48 blocks of 128 per routed expert (12 per rank at TP4)
-constexpr int DENSE_I = 24576;       // [cfg] layer 0 dense FFN
+constexpr int VOCAB = 204800;        // [cfg] vocab_size
+constexpr int VTILES = VOCAB / 128;  // [der] 1600 (400 per rank at TP4)
+constexpr int KSH = HID / 16;        // [der] 384
+constexpr int HB = HID / 128;        // [der] 48
 constexpr int L_MAIN = 72;           // [cfg] num_hidden_layers
-#define G6_MTP_L "L072"              // first DSpark layer (not built at this stage)
+#define G6_MTP_L "L072"              // pack index of the first DSpark layer (M3)
 constexpr int MTP_LAYER = L_MAIN;
 constexpr int NLAYERS = L_MAIN + 1;
-constexpr int VOCAB = 204800;        // [cfg] vocab_size
-constexpr int VTILES = VOCAB / 128;  // 1600
-constexpr int KSH = HID / 16;        // 384
-constexpr int HB = HID / 128;        // 48
+constexpr float RMS_EPS = 1e-5f;     // [cfg] rms_norm_eps (every RMSNorm)
+constexpr float LN_EPS = 1e-6f;      // [code] the indexer's two LayerNorms (q_input_norm, k_norm), weight + bias
+constexpr float SOFTCAP = 30.0f;     // [cfg] final_logit_softcapping: logits = 30 tanh(logits / 30)
+constexpr int HEAD_BITS = 6;         // [cfg] quantization_config.head_bits: output.trellis [384, 12800, 96]
+
+// --- MoE: 128 routed experts top-4 (softmax router, renormalized) + 1 shared; layer 0 dense ---
+constexpr int NEXP = ML4_BENCH_NEXP; // [cfg] n_routed_experts 128 (+1 shared row, see above)
+constexpr int NEXP_ROUTED = 128;     // [cfg] n_routed_experts
+constexpr int TOPK = 4;              // [cfg] num_experts_per_tok
+constexpr int EXP_I = 6144;          // [cfg] moe_intermediate_size (routed and shared)
+constexpr int EXP_BLOCKS = EXP_I / 128;   // [der] 48 (12 per rank at TP4)
+constexpr int DENSE_I = 24576;       // [cfg] intermediate_size: layer 0's dense SwiGLU
+constexpr float ROUTE_SCALE = 1.0f;  // [cfg] routed_scaling_factor
+constexpr bool is_moe(int l) { return l >= 1 && l < L_MAIN; }   // [cfg] first_k_dense_replace = 1
+
+// --- attention: MLA without q-LoRA, 64 heads of 128 (nope 64 + rope 64; NoPE layers 128 + 0), value 128 ---
 constexpr int HEADS = 64;            // [cfg] num_attention_heads
 constexpr int KV_LORA = 512;         // [cfg] kv_lora_rank
 constexpr int QK_ROPE = 64;          // [cfg] qk_rope_head_dim
-constexpr int KVA = KV_LORA + QK_ROPE;   // 576
-constexpr int IDX_HEADS = 32, IDX_DIM = 128, IDX_TOPK = 2048;   // [cfg] DSA indexer
-constexpr float ROUTE_SCALE = 1.0f;  // [cfg] routed_scaling_factor
-constexpr float RMS_EPS = 1e-5f;     // PLACEHOLDER until the port reads the config
-// GLM placeholders (see the header comment)
+constexpr int KVA = KV_LORA + QK_ROPE;    // [der] 576: the absorbed query / key width (NoPE layers: rope part 0)
+constexpr int ML4_QK_HEAD = 128;     // [cfg] qk_head_dim on every layer; softmax scale 128^-0.5 (no YaRN mscale)
+constexpr int ML4_QK_NOPE = 64;      // [cfg] qk_nope_head_dim (rope layers)
+constexpr int ML4_QK_NOPE_NR = ML4_QK_NOPE + QK_ROPE;   // [code] 128 on NoPE layers
+constexpr int ML4_V_HEAD = 128;      // [cfg] v_head_dim
+constexpr int ML4_Q_OUT = HEADS * ML4_QK_HEAD;   // [shape] wq [8192 <- 6144]
+constexpr int ML4_O_IN = HEADS * ML4_V_HEAD;     // [shape] wo [6144 <- 8192]
+constexpr int ML4_KVA_ROWS = 640;    // [shape] wkv_a_with_mqa on rope layers: 576 used, rows 576-639 zero
+constexpr float ROPE_THETA = 10000.0f;   // [cfg] rope_parameters.rope_theta
+constexpr float YARN_FACTOR = 2048.0f;   // [cfg] factor
+constexpr int YARN_ORIG_POS = 512;       // [cfg] original_max_position_embeddings
+constexpr float YARN_BETA_FAST = 32.0f, YARN_BETA_SLOW = 1.0f;   // [cfg]; attention_factor 1.0 (no magnitude scale)
+constexpr int MAX_POS = 1048576;     // [cfg] max_position_embeddings
+// [cfg] no_rope_layers: layer l uses RoPE unless (l + 1) % 4 == 0 (layers 3, 7, ..., 71: no rope in attention or indexer)
+constexpr bool rope(int l) { return (l + 1) % 4 != 0; }
+// [cfg] kv_source_layers: layers 39, 43, ..., 71 read layer 35's latent (all NoPE, as is 35); every other layer owns one
+constexpr int kv_src(int l) { return l >= 39 && l < L_MAIN && (l + 1) % 4 == 0 ? 35 : l; }
+constexpr bool owns_kv(int l) { return kv_src(l) == l; }
+// [cfg] indexer_types: "full" on layers 0..16 and l % 4 in {0, 3} from 19; "shared" reuse the previous full layer's top-k
+constexpr bool full_index(int l) { return l >= 0 && l < L_MAIN && (l <= 16 || l % 4 == 3 || l % 4 == 0); }
+// DSA indexer
+constexpr int IDX_HEADS = 32, IDX_DIM = 128, IDX_TOPK = 2048;   // [cfg] index_n_heads, index_head_dim, index_topk
+constexpr int ML4_IDXQ = IDX_HEADS * IDX_DIM;   // [shape] indexer.wq_b [4096 <- 6144] (from LayerNorm(h), no q-LoRA)
+
+// --- tokens ---
+constexpr int TOK_BOS = 1, TOK_EOS = 2;   // [cfg]
+
+// --- GLM PLACEHOLDERS (see the header comment): not ML4 values ---
 constexpr int QA = 2048;
 constexpr int QK_NOPE = 192;
 constexpr int V_HEAD = 256;
 constexpr int DFL_L = 6, DFL_NT = 6, DFL_NH = 64;
+
+// --- compile-time checks of the per-layer tables against config.json ---
+constexpr int count_full() { int n = 0; for (int l = 0; l < L_MAIN; ++l) n += full_index(l); return n; }
+constexpr int count_nope() { int n = 0; for (int l = 0; l < L_MAIN; ++l) n += !rope(l); return n; }
+constexpr int count_shared_kv() { int n = 0; for (int l = 0; l < L_MAIN; ++l) n += !owns_kv(l); return n; }
+constexpr bool shared_kv_ok() { for (int l = 0; l < L_MAIN; ++l) if (!owns_kv(l) && (rope(l) || rope(kv_src(l)) || kv_src(l) >= l)) return false; return true; }
+static_assert(count_full() == 44 && full_index(16) && !full_index(17) && !full_index(18) && full_index(19) && full_index(71),
+              "44 full indexer layers: 0-16, 19-20, 23-24, ..., 71");
+static_assert(count_nope() == 18 && !rope(3) && !rope(71) && rope(72 - 2), "18 NoPE layers: 3, 7, ..., 71");
+static_assert(count_shared_kv() == 9 && kv_src(39) == 35 && kv_src(71) == 35 && kv_src(35) == 35 && shared_kv_ok(),
+              "layers 39, 43, ..., 71 read layer 35's latent; all NoPE");
+static_assert(ML4_Q_OUT == 8192 && ML4_O_IN == 8192 && KVA == 576 && ML4_IDXQ == 4096, "wq, wo, kv_a, indexer wq_b");
 static_assert(VOCAB % 128 == 0 && HID % 128 == 0 && EXP_I % 128 == 0, "128-wide tiles");
-constexpr bool full_index(int l) { return l >= 0; }   // PLACEHOLDER (ML4: 44 full layers, PLAN.md)
 }
