+        json!([
+            {"type": "function", "function": {"name": "count_words", "parameters": {"type": "object"}}},
+            {"type": "function", "function": {"name": "get_weather", "parameters": {"type": "object"}}}
+        ])
+    }
+
+    type Got = (String, String, Vec<(String, String)>);
+
+    fn whole(p: &mut Ml4Parser, text: &str) -> Got {
+        let o = p.feed(text, true);
+        (o.reasoning, o.content, o.calls.into_iter().map(|c| (c.name.unwrap(), c.arguments.unwrap())).collect())
+    }
+
+    /// The same reply fed one character at a time.
+    fn by_char(mut p: Ml4Parser, text: &str) -> Got {
+        let (mut r, mut c, mut calls) = (String::new(), String::new(), Vec::new());
+        let cs: Vec<char> = text.chars().collect();
+        for (i, ch) in cs.iter().enumerate() {
+            let o = p.feed(&ch.to_string(), i + 1 == cs.len());
+            r.push_str(&o.reasoning);
+            c.push_str(&o.content);
+            calls.extend(o.calls.into_iter().map(|c| (c.name.unwrap(), c.arguments.unwrap())));
+        }
+        (r, c, calls)
+    }
+
+    fn p(t: Option<&Value>) -> Ml4Parser {
+        Ml4Parser::new(t, &json!("auto"), true)
+    }
+
+    #[test]
+    fn reasoning_then_answer() {
+        let text = "[THINK]step one[/THINK]The answer is 42.";
+        let want = ("step one".to_string(), "The answer is 42.".to_string(), vec![]);
+        assert_eq!(whole(&mut p(None), text), want);
+        assert_eq!(by_char(p(None), text), want);
+    }
+
+    #[test]
+    fn answer_without_a_think_block() {
+        assert_eq!(whole(&mut p(None), "Hello there.").1, "Hello there.");
+        // a [THINK] after the answer started is text
+        let (r, c, _) = whole(&mut p(None), "Hi [THINK]x[/THINK]");
+        assert_eq!((r.as_str(), c.as_str()), ("", "Hi [THINK]x[/THINK]"));
+    }
+
+    #[test]
+    fn a_call_after_thinking() {
+        let t = tools();
+        let text = "[THINK]need a tool[/THINK][TOOL_CALLS]count_words[ARGS]{\"phrase\": \"a b {c}\"}";
+        let want = ("need a tool".to_string(), String::new(), vec![("count_words".to_string(), "{\"phrase\": \"a b {c}\"}".to_string())]);
+        assert_eq!(whole(&mut p(Some(&t)), text), want);
+        assert_eq!(by_char(p(Some(&t)), text), want);
+    }
+
+    #[test]
+    fn two_calls_and_text_before() {
+        let t = tools();
+        let text = "Let me check.[TOOL_CALLS]get_weather[ARGS]{\"city\": \"Paris\"}[TOOL_CALLS]count_words[ARGS]{\"phrase\": \"x\"}";
+        let (_, c, calls) = by_char(p(Some(&t)), text);
+        assert_eq!(c, "Let me check.");
+        assert_eq!(calls.len(), 2);
+        assert_eq!(calls[1], ("count_words".to_string(), "{\"phrase\": \"x\"}".to_string()));
+        let f = p(Some(&t)).parse_full(text);
+        assert_eq!((f.content.as_deref(), f.calls.len()), (Some("Let me check."), 2));
+    }
+
+    #[test]
+    fn unknown_tool_or_bad_json_stays_text() {
+        let t = tools();
+        for text in ["[TOOL_CALLS]delete_all[ARGS]{}", "[TOOL_CALLS]count_words[ARGS]{\"phrase\": }", "[TOOL_CALLS]count_words[ARGS]{\"phrase\""] {
+            let (_, c, calls) = whole(&mut p(Some(&t)), text);
+            assert_eq!((c.as_str(), calls.len()), (text, 0), "{text}");
+            let (_, c, calls) = by_char(p(Some(&t)), text);
+            assert_eq!((c.as_str(), calls.len()), (text, 0), "{text} by char");
+        }
+    }
+
+    #[test]
+    fn no_tools_or_tool_choice_none_is_all_text() {
+        let text = "[TOOL_CALLS]count_words[ARGS]{}";
+        assert_eq!(whole(&mut p(None), text).1, text);
+        let t = tools();
+        assert_eq!(whole(&mut Ml4Parser::new(Some(&t), &json!("none"), true), text).1, text);
+    }
+
+    #[test]
+    fn reasoning_is_dropped_from_deltas_when_not_wanted() {
+        let mut q = Ml4Parser::new(None, &json!("auto"), false);
+        let d = q.delta("[THINK]hidden[/THINK]shown", true).unwrap();
+        assert_eq!((d.reasoning, d.content.as_deref()), (None, Some("shown")));
+    }
+}
