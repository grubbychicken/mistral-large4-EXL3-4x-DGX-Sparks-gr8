+    /// Mistral Large 4's forced reply (`dialect::ml4_forced_text`): the reply starts with the call, no think block.
+    pub fn forced_ids_ml4(&self, tok: &Tok) -> Result<Vec<u32>, ApiError> {
+        let text = match self {
+            ToolChoice::Required => Some(crate::dialect::ml4_forced_text(None)),
+            ToolChoice::Named(name) => Some(crate::dialect::ml4_forced_text(Some(name))),
+            ToolChoice::None | ToolChoice::Auto => None,
+        };
+        self.forced_ids_for(text, tok, &[])
+    }
