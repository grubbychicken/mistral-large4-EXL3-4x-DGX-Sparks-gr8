diff --git a/frontend/g6front-rs/src/ml4parser.rs b/frontend/g6front-rs/src/ml4parser.rs
new file mode 100644
index 0000000..bb19e7a
--- /dev/null
+++ b/frontend/g6front-rs/src/ml4parser.rs
@@ -0,0 +1,393 @@
+//! Mistral Large 4 reply parser: reasoning split + `[TOOL_CALLS]` calls (the inverse of the pack's chat_template.jinja).
+//!
+//! The reply, as the template writes an assistant turn back:
+//! - an optional think block, `[THINK]` reasoning `[/THINK]` (two special tokens), at the start of the reply; the prompt
+//!   never opens one, so the reply starts as the answer and the block opens in it;
+//! - the answer text;
+//! - zero or more calls, each `[TOOL_CALLS]name[ARGS]{json arguments}` (`[TOOL_CALLS]` and `[ARGS]` are special tokens);
+//! - the end of sequence (the engine stops on it; it is not text here).
+//!
+//! A call is taken only if tools were offered and `tool_choice` is not none, its name is an offered tool and its
+//! arguments are one well-formed JSON object. Anything else stays answer text, byte for byte. A `[THINK]` after the
+//! answer has started, or a second one, is text too.
+//!
+//! Streaming: partial tags are held back, and a call is emitted whole (id, name, arguments) once its JSON object closes.
+
+use std::collections::HashSet;
+
+use serde_json::Value;
+
+use crate::parser::{tool_call_id, Delta, FullParse, ToolDelta};
+use crate::pyjson::is_py_space;
+
+pub const THINK_OPEN: &str = "[THINK]";
+pub const THINK_CLOSE: &str = "[/THINK]";
+pub const CALLS: &str = "[TOOL_CALLS]";
+pub const ARGS: &str = "[ARGS]";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Mode {
+    /// Before any answer text: a think block may open here.
+    Start,
+    Reasoning,
+    Content,
+    /// After `[TOOL_CALLS]`, undecided: `buf` holds the name, `[ARGS]` and the arguments so far.
+    Call,
+}
+
+#[derive(Default)]
+struct Out {
+    reasoning: String,
+    content: String,
+    calls: Vec<ToolDelta>,
+}
+
+enum Parsed {
+    Need,
+    Bad,
+    /// (bytes used, name, arguments)
+    Ok(usize, String, String),
+}
+
+pub struct Ml4Parser {
+    tools: HashSet<String>,
+    parse_tools: bool,
+    pub include_reasoning: bool,
+    mode: Mode,
+    buf: String,
+    thought: bool,
+    n_calls: usize,
+}
+
+impl Ml4Parser {
+    /// `tools` is the request's tool list (OpenAI format).
+    pub fn new(tools: Option<&Value>, tool_choice: &Value, include_reasoning: bool) -> Ml4Parser {
+        let mut names = HashSet::new();
+        let mut any = false;
+        if let Some(Value::Array(ts)) = tools {
+            any = !ts.is_empty();
+            for t in ts {
+                if let Some(n) = crate::dschat::tool_name(t) {
+                    names.insert(n);
+                }
+            }
+        }
+        Ml4Parser {
+            tools: names,
+            parse_tools: any && tool_choice.as_str() != Some("none"),
+            include_reasoning,
+            mode: Mode::Start,
+            buf: String::new(),
+            thought: false,
+            n_calls: 0,
+        }
+    }
+
+    /// The reply starts as the answer, with no think block (a forced call: the insert rule wrote `[TOOL_CALLS]`).
+    pub fn content_first(mut self) -> Ml4Parser {
+        self.mode = Mode::Content;
+        self
+    }
+
+    fn content(&mut self, t: &str, out: &mut Out) {
+        if !t.is_empty() {
+            if self.mode == Mode::Start && !t.chars().all(is_py_space) {
+                self.mode = Mode::Content;
+            }
+            out.content.push_str(t);
+        }
+    }
+
+    fn feed(&mut self, text: &str, finished: bool) -> Out {
+        let mut out = Out::default();
+        self.buf.push_str(text);
+        loop {
+            match self.mode {
+                Mode::Start | Mode::Content => {
+                    let think = (self.mode == Mode::Start && !self.thought).then(|| self.buf.find(THINK_OPEN)).flatten();
+                    let call = self.parse_tools.then(|| self.buf.find(CALLS)).flatten();
+                    let next = match (think, call) {
+                        (Some(a), Some(b)) => Some(a.min(b)),
+                        (a, b) => a.or(b),
+                    };
+                    if let Some(p) = next {
+                        let head = self.buf[..p].to_string();
+                        if Some(p) == think {
+                            // only whitespace may come before the block (the template writes none)
+                            if head.chars().all(is_py_space) {
+                                self.buf.drain(..p + THINK_OPEN.len());
+                                self.mode = Mode::Reasoning;
+                                self.thought = true;
+                            } else {
+                                self.content(&head, &mut out);
+                                self.mode = Mode::Content;
+                                self.buf.drain(..p);
+                                let t = THINK_OPEN.to_string();
+                                self.content(&t, &mut out);
+                                self.buf.drain(..THINK_OPEN.len());
+                            }
+                        } else {
+                            self.content(&head, &mut out);
+                            self.buf.drain(..p + CALLS.len());
+                            self.mode = Mode::Call;
+                        }
+                        continue;
+                    }
+                    let keep = if finished {
+                        0
+                    } else {
+                        let mut k = 0;
+                        if self.mode == Mode::Start && !self.thought {
+                            k = k.max(partial_tag(&self.buf, THINK_OPEN));
+                        }
+                        if self.parse_tools {
+                            k = k.max(partial_tag(&self.buf, CALLS));
+                        }
+                        k
+                    };
+                    let n = self.buf.len() - keep;
+                    let t: String = self.buf.drain(..n).collect();
+                    self.content(&t, &mut out);
+                    break;
+                }
+                Mode::Reasoning => {
+                    if let Some(p) = self.buf.find(THINK_CLOSE) {
+                        out.reasoning.push_str(&self.buf[..p]);
+                        self.buf.drain(..p + THINK_CLOSE.len());
+                        self.mode = Mode::Start;   // the answer, or a call, follows; no second block
+                        continue;
+                    }
+                    let keep = if finished { 0 } else { partial_tag(&self.buf, THINK_CLOSE) };
+                    let n = self.buf.len() - keep;
+                    out.reasoning.push_str(&self.buf[..n]);
+                    self.buf.drain(..n);
+                    break;
+                }
+                Mode::Call => match parse_call(&self.buf, &self.tools) {
+                    Parsed::Need if !finished => break,
+                    Parsed::Ok(used, name, args) => {
+                        out.calls.push(ToolDelta {
+                            index: self.n_calls,
+                            id: Some(tool_call_id()),
+                            name: Some(name),
+                            arguments: Some(args),
+                        });
+                        self.n_calls += 1;
+                        self.buf.drain(..used);
+                        // whitespace between calls is not answer text
+                        let ws = self.buf.len() - self.buf.trim_start_matches(is_py_space).len();
+                        if ws < self.buf.len() || finished {
+                            self.buf.drain(..ws);
+                        }
+                        self.mode = Mode::Content;
+                        continue;
+                    }
+                    Parsed::Need | Parsed::Bad => {
+                        // not a call: the opener and what followed are answer text
+                        let rest = std::mem::take(&mut self.buf);
+                        self.mode = Mode::Content;
+                        let t = CALLS.to_string();
+                        self.content(&t, &mut out);
+                        // scanning resumes after the opener (a later [TOOL_CALLS] may still be a call)
+                        self.buf = rest;
+                        continue;
+                    }
+                },
+            }
+        }
+        out
+    }
+
+    // ---- streaming API ------------------------------------------------------------------------------------------
+
+    /// Feed newly decoded text; the delta's fields, or None if there is nothing to send yet.
+    pub fn delta(&mut self, text: &str, finished: bool) -> Option<Delta> {
+        let o = self.feed(text, finished);
+        let d = Delta {
+            content: (!o.content.is_empty()).then_some(o.content),
+            reasoning: (!o.reasoning.is_empty() && self.include_reasoning).then_some(o.reasoning),
+            tool_calls: o.calls,
+        };
+        (d.content.is_some() || d.reasoning.is_some() || !d.tool_calls.is_empty()).then_some(d)
+    }
+
+    // ---- non-streaming API --------------------------------------------------------------------------------------
+
+    /// On a fresh parser: the whole output at once.
+    pub fn parse_full(&mut self, text: &str) -> FullParse {
+        let o = self.feed(text, true);
+        let calls: Vec<(String, String, String)> = o
+            .calls
+            .into_iter()
+            .map(|c| (c.id.unwrap_or_else(tool_call_id), c.name.unwrap_or_default(), c.arguments.unwrap_or_default()))
+            .collect();
+        let content = if calls.is_empty() {
+            o.content.trim_start_matches(is_py_space).to_string()
+        } else {
+            o.content.trim_matches(is_py_space).to_string()
+        };
+        FullParse {
+            reasoning: (!o.reasoning.is_empty()).then_some(o.reasoning),
+            content: (!content.is_empty()).then_some(content),
+            calls,
+        }
+    }
+}
+
+/// The length of the longest proper prefix of `tag` that `text` ends with: bytes that may be the start of the tag.
+fn partial_tag(text: &str, tag: &str) -> usize {
+    let (t, g) = (text.as_bytes(), tag.as_bytes());
+    (1..g.len().min(t.len() + 1)).rev().find(|&n| t.ends_with(&g[..n])).unwrap_or(0)
+}
+
+/// `name[ARGS]{...}` at the start of `s` (after `[TOOL_CALLS]`): the arguments are one JSON object, read up to its
+/// closing brace (strings and escapes respected), then checked with serde_json.
+fn parse_call(s: &str, known: &HashSet<String>) -> Parsed {
+    let Some(a) = s.find(ARGS) else {
+        // a name is short and has no special token or newline in it (a partial [ARGS] at the end may still arrive)
+        let head = &s[..s.len() - partial_tag(s, ARGS)];
+        return if head.contains(['\n', '[']) || s.len() > 256 { Parsed::Bad } else { Parsed::Need };
+    };
+    let name = s[..a].trim();
+    if name.is_empty() || name.contains(['\n', '[']) || !known.contains(name) {
+        return Parsed::Bad;
+    }
+    let body = &s[a + ARGS.len()..];
+    let lead = body.len() - body.trim_start_matches(is_py_space).len();
+    let b = &body[lead..];
+    if b.is_empty() {
+        return Parsed::Need;
+    }
+    if !b.starts_with('{') {
+        return Parsed::Bad;
+    }
+    let (mut depth, mut in_str, mut esc) = (0i64, false, false);
+    for (i, c) in b.char_indices() {
+        if in_str {
+            if esc {
+                esc = false;
+            } else if c == '\\' {
+                esc = true;
+            } else if c == '"' {
+                in_str = false;
+            }
+            continue;
+        }
+        match c {
+            '"' => in_str = true,
+            '{' | '[' => depth += 1,
+            '}' | ']' => {
+                depth -= 1;
+                if depth == 0 {
+                    let json = &b[..=i];
+                    return match serde_json::from_str::<Value>(json) {
+                        Ok(Value::Object(_)) => Parsed::Ok(a + ARGS.len() + lead + i + 1, name.to_string(), json.to_string()),
+                        _ => Parsed::Bad,
+                    };
+                }
+            }
+            _ => {}
+        }
+    }
+    Parsed::Need
+}
+
