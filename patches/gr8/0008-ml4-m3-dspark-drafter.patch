diff --git a/engine/runtime/ml4_dspark.cuh b/engine/runtime/ml4_dspark.cuh
new file mode 100644
index 0000000..c72e914
--- /dev/null
+++ b/engine/runtime/ml4_dspark.cuh
@@ -0,0 +1,856 @@
+// Mistral Large 4's DSpark draft head behind the DFlash2 drafter interface (dflash.cuh includes this file instead of its
+// own body in a G6_MODEL_ML4 build; g6m4's and S2's --dflash paths drive it unchanged). The recipe's docs/PORT.md
+// section 9 has the math (the pack author's TensorFold port; the recipe's tools/d0_dspark_ref.py is its PyTorch form):
+//   context  for every accepted row: features = the target residual after layers 1, 18, 36, 54, 71 (fp16, FEAT_SCALE)
+//            -> target_projection (this rank's 1536 outputs) -> all-gather (collective 0) -> RMS(target_norm) -> per
+//            draft layer j: kva = wkv_a x [576], latent = RMS(kva[:512], kv_norm), kvb = wkv_b latent (this rank's 16
+//            heads x [64 k_nope | 128 v]); key = [k_nope | YaRN rope(kva[512:], pos)], value -> the ring at pos
+//   block    3 rows at q0 .. q0+2: [emb(tok0), mask_0, mask_1], 3 layers: attention_norm, wq (16 heads x 128, rope on the
+//            last 64), the rows' own keys / values into the ring, attention over the ring's keys q0-2048 .. q0+2 (no mask
+//            in the block), wo partial -> all-reduce (collective 1 + 2j); ffn_norm, SwiGLU (this rank's 6144 of 24576),
+//            w2 partial -> all-reduce (2 + 2j); final_norm
+//   tokens   the target head on the 3 rows (this rank's vocab slice, softcap 30) + the autoregressive head, row by row:
+//            joint [state | emb_ar(prev) | h_i] -> joint_proj + b -> GRU-like state update -> output (this rank's slice)
+//            -> local best of head + markov -> all-gather of the picks (collective 7 + i) -> the draft (prev of row i+1)
+// The verify block is B = 4 rows (the bonus token + 3 drafts). Weights: tools/ml4_dspark_pack.py's rank pack (BF16W
+// records, gr8's BF16 GEMV on bf16 fragments).
+#pragma once
+#include "prefill.cuh"
+#include "../module_info.h"
+
+namespace g6rt
+{
+namespace dfl
+{
+constexpr int B = 4, K = B - 1;               // verify rows: the bonus token + 3 drafts
+static_assert(B == g6mod::INFO.dfl_block, "the drafter's block rows and the module description (module_info.h) differ");
+constexpr int Q = 3;                          // the draft block's rows (the trained three)
+constexpr int L = 3, NT = 5;                  // draft layers, tapped target layers
+constexpr int TAPS[NT] = {1, 18, 36, 54, 71};
+constexpr int HD = 128, NH = 64, NHR = NH / g6nr::NR, QW = NHR * HD;   // 16 heads a rank, 2048
+constexpr int DKVA = 576, LAT = 512, KVB = NHR * 192;
+constexpr int INTER = 24576, NIR = INTER / g6nr::NR;                   // 6144 a rank
+constexpr int NFR = HID / g6nr::NR;                                    // target_projection outputs a rank
+constexpr int JIN = 512 + 512 + HID, JOUT = 1536, ST = 512;
+constexpr int CR = MX;                        // context rows a draft step carries at most (a prompt step's chunk)
+constexpr int RING = 4096, WIN = 2048;
+constexpr int NC = 1 + 2 * L + Q;             // 0 tp slices, 1 + 2j / 2 + 2j layer j partials, 7 + i row i's picks
+constexpr int NPH = NC + 1;
+constexpr int SPLIT = 16;                     // attention key splits per head
+constexpr bool REP = false;                   // TP4 only
+constexpr float FEAT_SCALE = 1.f / 64.f;      // target residual -> fp16 features; target_projection is linear
+constexpr float SOFTCAP = 30.f;
+constexpr unsigned ERR = 0x64000000u;
+enum { C_ROWS, C_POS0, C_Q0, C_LO, C_N };
+static_assert(g6nr::NR == 4, "ML4 DSpark: the TP4 split (tools/ml4_dspark_pack.py)");
+static_assert(NT + 1 <= NC, "a fill step's NT feature gathers and its tp slices use collectives 0 .. NT");
+}
+
+struct DflIn
+{
+    u64 step;
+    int ctx_rows, ctx_pos0, q0, lo, tok0, query;
+    glue::SampleRow srow[dfl::B];     // unused (greedy drafts); kept for the callers
+};
+struct DflOut
+{
+    int tok[dfl::B];                  // tok[r] = draft for position q0 + r (r = 1..3)
+    float lp[dfl::B];                 // 0: the head reports no draft probabilities
+};
+struct DflMeta { int mask_id = 0, nr = 0, block = 0, layers = 0, window = 0; int tl[dfl::NT] = {}; float theta = 0, eps = 0; bool sel = false; };
+struct DLayer
+{
+    bind::Gv kva_c, kvb_c, kva_b, kvb_b, wq, wo, w1, w3, w2;
+    const __nv_bfloat16 *attn_norm = nullptr, *ffn_norm = nullptr, *kv_norm = nullptr;
+};
+struct Dfl
+{
+    int rank = -1;
+    bool sel = false;                 // the callers' selector switch: never on here
+    float sel_alpha = 1.f;
+    float eps = 1e-5f;
+    int tlayer[dfl::NT] = {};
+    g6::FabricDev f{};
+    u64* stepp = nullptr;
+    unsigned* tickets = nullptr;
+    const DflIn* in = nullptr;
+    DflOut* out = nullptr;
+    int nc = 0;
+    int* cell = nullptr;
+    int *tok = nullptr, *qpos = nullptr, *sel_tok = nullptr;
+    const __nv_bfloat16* emb = nullptr;      // the target's token embeddings
+    const int* emb_rows = nullptr;
+    float* freq = nullptr;                    // [32] YaRN
+    // weights
+    bind::Gv tp, jp, ar_out;
+    DLayer ly[dfl::L];
+    const __nv_bfloat16 *tnorm = nullptr, *fnorm = nullptr, *mask = nullptr, *jbias = nullptr, *ar_emb = nullptr;
+    // context
+    __half* feat = nullptr;           // [CR][NT][HID] fp16 x FEAT_SCALE
+    __half* pf_feat = nullptr;        // [WIN][NT][HID] prompt context rows written by the prefill (owner rows)
+    int pf_lo = 0, pf_hi = 0;
+    u32* xb_feat = nullptr;
+    float* tpo = nullptr;             // [CR][NFR]
+    __half* ctxn = nullptr;           // [CR][HID]
+    __half *ckva = nullptr, *clat = nullptr, *ckvb = nullptr;   // [CR][576], [CR][512], [CR][KVB]
+    u32 *xb_ctxn = nullptr, *xb_clat = nullptr;
+    __half *kring = nullptr, *vring = nullptr;                  // [L][NHR][RING][HD]
+    // block
+    float* resid = nullptr;           // [Q][HID]
+    __half* x = nullptr;              // [Q][HID] the current norm output
+    u32* xb_x = nullptr;
+    __half *bkva = nullptr, *blat = nullptr, *bkvb = nullptr, *q = nullptr;
+    u32* xb_blat = nullptr;
+    float* qf = nullptr;              // [Q][NHR][HD]
+    float* apart = nullptr;           // [NHR][SPLIT][Q][HD + 2]
+    __half* ao = nullptr;             // [Q][QW]
+    u32* xb_ao = nullptr;
+    uint16_t* part = nullptr;         // [Q][HID] BF16 partial
+    __half *g = nullptr, *u = nullptr, *act = nullptr;          // [Q][NIR]
+    u32* xb_act = nullptr;
+    // head
+    bind::Head head;
+    u32* xf_head = nullptr;
+    float* hlog = nullptr;            // [Q][vn]
+    __half* jin = nullptr;            // [JIN] (one row: fragments are per 16 rows)
+    u32* xb_jin = nullptr;
+    float* jpo = nullptr;             // [JOUT]
+    float* state = nullptr;           // [ST]
+    __half* markov = nullptr;         // [ST]
+    u32* xb_markov = nullptr;
+    float* arlog = nullptr;           // [vn]
+    int vlo = 0, vn = 0;
+};
+
+namespace dspk
+{
+using namespace dfl;
+__device__ __forceinline__ float bfr(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }   // a BF16 rounding
+
+struct InArgs { const uint32_t* in; u64* stepp; int* cell; int* tok; int* qpos; };
+__global__ void __launch_bounds__(128) k_in(InArgs a)
+{
+    __shared__ DflIn sh;
+    const int t = threadIdx.x;
+    for (int i = t; i < (int)(sizeof(DflIn) / 4); i += 128) reinterpret_cast<uint32_t*>(&sh)[i] = __ldcv(a.in + i);
+    __syncthreads();
+    if (t == 0)
+    {
+        *a.stepp = sh.step;
+        a.cell[C_ROWS] = sh.ctx_rows; a.cell[C_POS0] = sh.ctx_pos0; a.cell[C_Q0] = sh.q0; a.cell[C_LO] = sh.lo;
+        a.tok[0] = sh.tok0;
+    }
+    if (t < Q) a.qpos[t] = sh.q0 + t;
+}
+// YaRN interleaved-pair frequencies (tf_large4_dspark_frequency): theta 1e4, factor 2048, original 512, beta 32 / 1
+__global__ void k_freq(float* out, float low, float high)
+{
+    const int i = threadIdx.x;
+    if (i >= 32) return;
+    const float base = powf(10000.f, float(2 * i) / 64.f), ramp = fminf(1.f, fmaxf(0.f, (float(i) - low) / (high - low)));
+    out[i] = (1.f / (2048.f * base)) * ramp + (1.f / base) * (1.f - ramp);
+}
+// element d (0..63) of rope(x[0..63]) at pos: GPT-J interleaved pairs, fp32 trig (the reference's rotate)
+__device__ __forceinline__ float rope_at(const __half* x, const float* freq, int d, int pos)
+{
+    const int p = d >> 1;
+    const float ang = float(pos) * freq[p], co = cosf(ang), si = sinf(ang);
+    const float ev = __half2float(x[2 * p]), od = __half2float(x[2 * p + 1]);
+    return (d & 1) ? od * co + ev * si : ev * co - od * si;
+}
+// target residual rows -> fp16 features of tap slot s. grid (HID / 256, M), block 256
+__global__ void __launch_bounds__(256) k_tap(const float* resid, __half* feat, int s)
+{
+    const int m = blockIdx.y, c = blockIdx.x * 256 + threadIdx.x;
+    feat[((size_t)m * NT + s) * HID + c] = __float2half_rn(resid[(size_t)m * HID + c] * FEAT_SCALE);
+}
+// prefill rows r0 .. r0+rows-1 whose positions fall in [lo, hi) -> pf_feat[pos - lo], tap slot s
+__global__ void __launch_bounds__(256) k_pf_tap(const float* resid, const int* pos, int r0, int lo, int hi, __half* pf, int s)
+{
+    const int m = r0 + blockIdx.y, c = blockIdx.x * 256 + threadIdx.x, p = pos[m];
+    if (p < lo || p >= hi) return;
+    pf[((size_t)(p - lo) * NT + s) * HID + c] = __float2half_rn(resid[(size_t)m * HID + c] * FEAT_SCALE);
+}
+// one block per row: RMS of a [rows][K] fp32 or fp16 row with a BF16 weight -> fp16. src16 or src32 is null.
+__global__ void __launch_bounds__(256) k_rms(const float* src32, const __half* src16, int lds, int K, const __nv_bfloat16* w, float eps,
+                                             __half* out, int ldo, const int* rows_cell)
+{
+    const int m = blockIdx.x;
+    if (rows_cell && m >= *rows_cell) return;
+    __shared__ float sh[8];
+    float ss = 0.f;
+    for (int c = threadIdx.x; c < K; c += 256)
+    {
+        const float v = src32 ? src32[(size_t)m * lds + c] : __half2float(src16[(size_t)m * lds + c]);
+        ss += v * v;
+    }
+    for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    if ((threadIdx.x & 31) == 0) sh[threadIdx.x >> 5] = ss;
+    __syncthreads();
+    float tot = 0.f;
+    for (int i = 0; i < 8; ++i) tot += sh[i];
+    const float inv = rsqrtf(tot / float(K) + eps);
+    for (int c = threadIdx.x; c < K; c += 256)
+    {
+        const float v = src32 ? src32[(size_t)m * lds + c] : __half2float(src16[(size_t)m * lds + c]);
+        out[(size_t)m * ldo + c] = __float2half_rn(v * inv * __bfloat162float(w[c]));
+    }
+}
+// collective c: every rank's [CR][NFR] fp32 tp outputs -> the full rows / FEAT_SCALE -> RMS(target_norm) -> ctxn. One
+// block per context row (rows past the cell's count are skipped)
+struct CtxArgs { g6::FabricDev f; const u64* stepp; int c; const __nv_bfloat16* w; __half* out; float eps; const int* cell; };
+__global__ void __launch_bounds__(256) k_ctx_norm(CtxArgs a)
+{
+    const u64 step = *a.stepp;
+    const int m = blockIdx.x;
+    if (m >= a.cell[C_ROWS]) return;
+    __shared__ float sh[8];
+    auto at = [&](int c) {
+        const int p = c / NFR;
+        return __ldcv(reinterpret_cast<const float*>(glue::peer_slot(a.f, step, a.c, p)) + (size_t)m * NFR + (c - p * NFR)) / FEAT_SCALE;
+    };
+    float ss = 0.f;
+    for (int c = threadIdx.x; c < HID; c += 256) { const float v = at(c); ss += v * v; }
+    for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    if ((threadIdx.x & 31) == 0) sh[threadIdx.x >> 5] = ss;
+    __syncthreads();
+    float tot = 0.f;
+    for (int i = 0; i < 8; ++i) tot += sh[i];
+    const float inv = rsqrtf(tot / float(HID) + a.eps);
+    for (int c = threadIdx.x; c < HID; c += 256) a.out[(size_t)m * HID + c] = __float2half_rn(at(c) * inv * __bfloat162float(a.w[c]));
+}
+// keys / values of rows (context: positions pos0 + row for row < cell rows; block: qpos[row]) -> the ring of layer j.
+// grid (rows, NHR), block 128 (thread = dimension)
+struct KvArgs { const __half *kva, *kvb; const float* freq; __half *kr, *vr; const int* cell; const int* qpos; int ctx; };
+__global__ void __launch_bounds__(128) k_kv(KvArgs a)
+{
+    const int m = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+    if (a.ctx && m >= a.cell[C_ROWS]) return;
+    const int pos = a.ctx ? a.cell[C_POS0] + m : a.qpos[m];
+    const __half* e = a.kvb + (size_t)m * KVB + h * 192;
+    const float k = d < 64 ? __half2float(e[d]) : rope_at(a.kva + (size_t)m * DKVA + LAT, a.freq, d - 64, pos);
+    const size_t o = ((size_t)h * RING + (pos & (RING - 1))) * HD + d;
+    a.kr[o] = __float2half_rn(k);
+    a.vr[o] = e[64 + d];
+}
+// the block's queries: q [Q][NHR][HD] -> nope as is, rope on dims 64..127 at qpos. grid (Q, NHR), block 128
+__global__ void __launch_bounds__(128) k_q(const __half* q, const float* freq, const int* qpos, float* qf)
+{
+    const int r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+    const __half* x = q + (size_t)r * QW + h * HD;
+    qf[((size_t)r * NHR + h) * HD + d] = d < 64 ? __half2float(x[d]) : rope_at(x + 64, freq, d - 64, qpos[r]);
+}
+// attention of the Q block rows over ring positions [max(lo, q0 - WIN), q0 + Q), split over SPLIT key ranges; each warp
+// an online softmax over its keys (lane = 4 dimensions), the warps merged per split. grid (NHR, SPLIT), block 128.
+// part [h][split][r][HD + 2]: max, sum, unnormalized output
+struct AttnArgs { const float* qf; const __half *kr, *vr; const int* cell; float* part; };
+__global__ void __launch_bounds__(128) k_attn(AttnArgs a)
+{
+    __shared__ float sm[4][Q][HD + 2];
+    const int h = blockIdx.x, split = blockIdx.y, warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int q0 = a.cell[C_Q0], k0 = max(a.cell[C_LO], q0 - WIN), n = q0 + Q - k0;
+    const int chunk = (n + SPLIT - 1) / SPLIT, s0 = split * chunk, s1 = min(n, s0 + chunk);
+    const float scale = rsqrtf(128.f);
+    float q[Q][4], m[Q], l[Q], acc[Q][4];
+    #pragma unroll
+    for (int r = 0; r < Q; ++r)
+    {
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) { q[r][j] = a.qf[((size_t)r * NHR + h) * HD + lane * 4 + j]; acc[r][j] = 0.f; }
+        m[r] = -INFINITY; l[r] = 0.f;
+    }
+    for (int t = s0 + warp; t < s1; t += 4)
+    {
+        const int pos = k0 + t;
+        const size_t o = ((size_t)h * RING + (pos & (RING - 1))) * HD + lane * 4;
+        const uint2 kv = *reinterpret_cast<const uint2*>(a.kr + o), vv = *reinterpret_cast<const uint2*>(a.vr + o);
+        const __half* kk = reinterpret_cast<const __half*>(&kv);
+        const __half* vh = reinterpret_cast<const __half*>(&vv);
+        #pragma unroll
+        for (int r = 0; r < Q; ++r)
+        {
+            float s = q[r][0] * __half2float(kk[0]) + q[r][1] * __half2float(kk[1]) + q[r][2] * __half2float(kk[2]) + q[r][3] * __half2float(kk[3]);
+            for (int x = 16; x > 0; x >>= 1) s += __shfl_xor_sync(0xffffffffu, s, x);
+            s *= scale;
+            const float mn = fmaxf(m[r], s), corr = expf(m[r] - mn), p = expf(s - mn);
+            l[r] = l[r] * corr + p;
+            #pragma unroll
+            for (int j = 0; j < 4; ++j) acc[r][j] = acc[r][j] * corr + p * __half2float(vh[j]);
+            m[r] = mn;
+        }
+    }
+    #pragma unroll
+    for (int r = 0; r < Q; ++r)
+    {
+        if (lane == 0) { sm[warp][r][0] = m[r]; sm[warp][r][1] = l[r]; }
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) sm[warp][r][2 + lane * 4 + j] = acc[r][j];
+    }
+    __syncthreads();
+    const int d = threadIdx.x;
+    for (int r = 0; r < Q; ++r)
+    {
+        float mx = -INFINITY;
+        for (int w = 0; w < 4; ++w) mx = fmaxf(mx, sm[w][r][0]);
+        float sum = 0.f, o = 0.f;
+        if (mx != -INFINITY)
+            for (int w = 0; w < 4; ++w)
+                if (sm[w][r][0] != -INFINITY) { const float e = expf(sm[w][r][0] - mx); sum += sm[w][r][1] * e; o += sm[w][r][2 + d] * e; }
+        float* p = a.part + (((size_t)h * SPLIT + split) * Q + r) * (HD + 2);
+        if (d == 0) { p[0] = mx; p[1] = sum; }
+        p[2 + d] = o;
+    }
+}
+// the splits merged -> ao [Q][QW] fp16. grid NHR, block 128
+__global__ void __launch_bounds__(128) k_attn_join(const float* part, __half* ao)
+{
+    const int h = blockIdx.x, d = threadIdx.x;
+    for (int r = 0; r < Q; ++r)
+    {
+        float mx = -INFINITY;
+        for (int s = 0; s < SPLIT; ++s) mx = fmaxf(mx, part[(((size_t)h * SPLIT + s) * Q + r) * (HD + 2)]);
+        float sum = 0.f, o = 0.f;
+        for (int s = 0; s < SPLIT; ++s)
+        {
+            const float* p = part + (((size_t)h * SPLIT + s) * Q + r) * (HD + 2);
+            if (p[0] == -INFINITY) continue;
+            const float e = expf(p[0] - mx);
+            sum += p[1] * e; o += p[2 + d] * e;
+        }
+        ao[(size_t)r * QW + h * HD + d] = __float2half_rn(o / sum);
+    }
+}
+// the block's rows: [emb(tok0), mask_0, mask_1] -> resid (fp32), and x = RMS(row, w). grid Q, block 256
+__global__ void __launch_bounds__(256) k_block_in(const __nv_bfloat16* emb, const int* tok, const __nv_bfloat16* mask, float* resid)
+{
+    const int r = blockIdx.x;
+    const __nv_bfloat16* src = r == 0 ? emb + (size_t)tok[0] * HID : mask + (size_t)(r - 1) * HID;
+    for (int c = threadIdx.x; c < HID; c += 256) resid[(size_t)r * HID + c] = __bfloat162float(src[c]);
+}
+// collective c: the ranks' BF16 partials [Q][HID] summed in rank order, added to resid, then x = RMS(resid, w). grid Q, block 256
+struct SumArgs { g6::FabricDev f; const u64* stepp; int c; float* resid; const __nv_bfloat16* w; __half* x; float eps; };
+__global__ void __launch_bounds__(256) k_sum_norm(SumArgs a)
+{
+    const u64 step = *a.stepp;
+    const int r = blockIdx.x;
+    __shared__ float sh[8];
+    float ss = 0.f;
+    for (int c = threadIdx.x; c < HID; c += 256)
+    {
+        float s = 0.f;
+        for (int p = 0; p < g6nr::NR; ++p)
+            s += __bfloat162float(__ldcv(reinterpret_cast<const __nv_bfloat16*>(glue::peer_slot(a.f, step, a.c, p)) + (size_t)r * HID + c));
+        const float v = a.resid[(size_t)r * HID + c] + s;
+        a.resid[(size_t)r * HID + c] = v;
+        ss += v * v;
+    }
+    for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    if ((threadIdx.x & 31) == 0) sh[threadIdx.x >> 5] = ss;
+    __syncthreads();
+    float tot = 0.f;
+    for (int i = 0; i < 8; ++i) tot += sh[i];
+    const float inv = rsqrtf(tot / float(HID) + a.eps);
+    for (int c = threadIdx.x; c < HID; c += 256)
+        a.x[(size_t)r * HID + c] = __float2half_rn(a.resid[(size_t)r * HID + c] * inv * __bfloat162float(a.w[c]));
+}
+__global__ void __launch_bounds__(256) k_swiglu(const __half* g, const __half* u, __half* out, int n)
+{
+    const int i = blockIdx.x * 256 + threadIdx.x;
+    if (i >= n) return;
+    const float x = __half2float(g[i]);
+    out[i] = __float2half_rn(x / (1.f + expf(-x)) * __half2float(u[i]));
+}
+__global__ void __launch_bounds__(256) k_softcap(float* y, int n)
+{
+    const int i = blockIdx.x * 256 + threadIdx.x;
+    if (i < n) y[i] = SOFTCAP * tanhf(y[i] / SOFTCAP);
+}
+// the autoregressive head's input of row i: [state | emb_ar(prev) | x_i], prev = tok0 (i = 0) or row i-1's draft
+__global__ void __launch_bounds__(256) k_joint(const float* state, const __nv_bfloat16* ar_emb, const __half* x, const int* tok,
+                                               const int* sel, int i, __half* jin)
+{
+    int prev = i == 0 ? tok[0] : sel[i - 1];
+    if (prev < 0 || prev >= glue::VOCAB) prev = 0;
+    for (int c = threadIdx.x; c < JIN; c += 256)
+        jin[c] = c < ST ? __float2half_rn(state[c])
+                        : c < 2 * ST ? __float2half_rn(__bfloat162float(ar_emb[(size_t)prev * ST + c - ST])) : x[(size_t)i * HID + c - 2 * ST];
+}
+// the GRU-like step with the reference's BF16 stages (tf_large4_dspark_rnn); i == 0 starts from a zero state
+__global__ void __launch_bounds__(256) k_rnn(const float* jp, const __nv_bfloat16* bias, float* state, __half* markov, int i)
+{
+    for (int c = threadIdx.x; c < ST; c += 256)
+    {
+        const float s0 = i == 0 ? 0.f : state[c];
+        const float g = bfr(1.f / (1.f + expf(-bfr(jp[c] + __bfloat162float(bias[c])))));
+        const float cand = bfr(tanhf(bfr(jp[ST + c] + __bfloat162float(bias[ST + c]))));
+        const float o = bfr(tanhf(bfr(jp[2 * ST + c] + __bfloat162float(bias[2 * ST + c]))));
+        const float first = bfr(g * s0), second = bfr(bfr(1.f - g) * cand);
+        state[c] = bfr(first + second);
+        markov[c] = __float2half_rn(o);
+    }
+}
+struct Pick { float value; int id; int bad; int pad; };
+// this rank's best of head + markov over its vocab slice (the markov logits rounded to BF16 as the reference stores
+// them; the lowest id on a tie) -> its send slot of collective c. grid 1, block 1024
+__global__ void __launch_bounds__(1024) k_pick(const float* hlog, const float* arlog, int vn, int vlo, g6::FabricDev f, const u64* stepp,
+                                               int c, unsigned* ticket)
+{
+    __shared__ float bv[32];
+    __shared__ int bi[32], bb[32];
+    float val = -INFINITY;
+    int id = 0x7fffffff, bad = 0;
+    for (int j = threadIdx.x; j < vn; j += 1024)
+    {
+        const float x = hlog[j] + bfr(arlog[j]);
+        if (!isfinite(x)) bad = 1;
+        if (x > val || (x == val && j < id)) { val = x; id = j; }
+    }
+    for (int o = 16; o > 0; o >>= 1)
+    {
+        const float ov = __shfl_xor_sync(0xffffffffu, val, o);
+        const int oi = __shfl_xor_sync(0xffffffffu, id, o);
+        bad |= __shfl_xor_sync(0xffffffffu, bad, o);
+        if (ov > val || (ov == val && oi < id)) { val = ov; id = oi; }
+    }
+    if ((threadIdx.x & 31) == 0) { bv[threadIdx.x >> 5] = val; bi[threadIdx.x >> 5] = id; bb[threadIdx.x >> 5] = bad; }
+    __syncthreads();
+    if (threadIdx.x == 0)
+    {
+        for (int w = 1; w < 32; ++w)
+        {
+            bad |= bb[w];
+            if (bv[w] > val || (bv[w] == val && bi[w] < id)) { val = bv[w]; id = bi[w]; }
+        }
+        const u64 step = *stepp;
+        Pick* p = reinterpret_cast<Pick*>(glue::send_slot(f, step, c));
+        p->value = val; p->id = vlo + id; p->bad = bad; p->pad = 0;
+        glue::publish(f, c, g6::coll_seq(step, c, f.ncoll), ticket);
+    }
+}
+// the ranks' picks of collective c -> the draft of row i (the larger value, the lower id on a tie; -1 when any is bad)
+__global__ void k_pick_merge(g6::FabricDev f, const u64* stepp, int c, int* sel, int i)
+{
+    if (threadIdx.x) return;
+    const u64 step = *stepp;
+    int bad = 0, id = 0x7fffffff;
+    float val = -INFINITY;
+    for (int p = 0; p < g6nr::NR; ++p)
+    {
+        const Pick* q = reinterpret_cast<const Pick*>(glue::peer_slot(f, step, c, p));
+        const float v = __ldcv(&q->value);
+        const int d = __ldcv(&q->id);
+        bad |= __ldcv(&q->bad);
+        if (v > val || (v == val && d < id)) { val = v; id = d; }
+    }
+    sel[i] = bad ? -1 : id;
+}
+__global__ void k_out(const int* sel, DflOut* out)
+{
+    if (threadIdx.x) return;
+    out->tok[0] = 0; out->lp[0] = 0.f;
+    for (int r = 1; r < B; ++r) { out->tok[r] = sel[r - 1]; out->lp[r] = 0.f; }
+}
+// a fill step: this rank's prompt-context rows of tap slot s (zero where it is not the owner) -> collective s. grid 1, block 128
+__global__ void __launch_bounds__(128) k_fill_put(const __half* pf, const int* cell, int s, g6::FabricDev f, const u64* stepp, unsigned* ticket)
+{
+    const u64 step = *stepp;
+    const int rows = cell[C_ROWS], p0 = cell[C_POS0] - cell[C_LO];
+    uint4* dst = reinterpret_cast<uint4*>(glue::send_slot(f, step, s));
+    constexpr int W = HID * 2 / 16;
+    for (int i = threadIdx.x; i < B * W; i += 128)
+    {
+        const int m = i / W, w = i % W;
+        dst[i] = m < rows ? reinterpret_cast<const uint4*>(pf + ((size_t)(p0 + m) * NT + s) * HID)[w] : make_uint4(0, 0, 0, 0);
+    }
+    glue::publish(f, s, g6::coll_seq(step, s, f.ncoll), ticket);
+}
+// the ranks' rows summed (exactly one is non-zero) -> feat. grid (HID / 256, B, NT), block 256
+__global__ void __launch_bounds__(256) k_fill_get(g6::FabricDev f, const u64* stepp, __half* feat)
+{
+    const u64 step = *stepp;
+    const int c = blockIdx.x * 256 + threadIdx.x, m = blockIdx.y, s = blockIdx.z;
+    float v = 0.f;
+    for (int p = 0; p < g6nr::NR; ++p)
+        v += __half2float(__ldcv(reinterpret_cast<const __half*>(glue::peer_slot(f, step, s, p)) + (size_t)m * HID + c));
+    feat[((size_t)m * NT + s) * HID + c] = __float2half_rn(v);
+}
+}   // namespace dspk
+
+inline DflMeta dfl_read_meta(const Find& find)
+{
+    const TensorRef t = find("DS.tp.gv");
+    if (!t.p) die("--dflash-manifest: not an ML4 DSpark pack (no DS.tp.gv; the recipe's tools/ml4_dspark_pack.py)");
+    DflMeta m;
+    m.nr = g6nr::NR; m.block = dfl::B; m.layers = dfl::L; m.window = dfl::WIN; m.eps = 1e-5f;
+    for (int i = 0; i < dfl::NT; ++i) m.tl[i] = dfl::TAPS[i];
+    return m;
+}
+inline void dfl_build(Dfl& D, const Model& main, const Find& find, const DflMeta& meta, const g6::FabricDev& f, u64* stepp, bool sel,
+                      cudaStream_t st, bool pf = false)
+{
+    using namespace dfl;
+    if (sel) die("ML4 DSpark: no selector (--dflash-sel 1)");
+    if (f.ncoll != NC || f.stride < (size_t)CR * NFR * 4 + 8 || f.stride < (size_t)B * HID * 2 + 8) die("ML4 DSpark fabric: wrong collective count or slot size");
+    D.rank = main.rank; D.f = f; D.stepp = stepp; D.eps = meta.eps;
+    for (int i = 0; i < NT; ++i) D.tlayer[i] = meta.tl[i];
+    D.emb = main.emb;
+    D.tickets = dmalloc<unsigned>(NC);
+    D.cell = dmalloc<int>(C_N);
+    D.tok = dmalloc<int>(B);
+    D.qpos = dmalloc<int>(B);
+    D.sel_tok = dmalloc<int>(Q);
+    D.freq = dmalloc<float>(32);
+    {   // the YaRN ramp's ends (the reference's yarnEndpoints)
+        const double orig = 512, th = 10000;
+        double lo = std::max(std::floor(64 * std::log(orig / (32 * 2 * M_PI)) / (2 * std::log(th))), 0.0);
+        double hi = std::min(std::ceil(64 * std::log(orig / (1 * 2 * M_PI)) / (2 * std::log(th))), 63.0);
+        if (lo == hi) hi += 0.001;
+        dspk::k_freq<<<1, 32, 0, st>>>(D.freq, (float)lo, (float)hi);
+    }
+    auto frag = [&](int k) { return dmalloc<u32>((size_t)g6mx::NT * k / 16 * 64); };
+    D.feat = dmalloc<__half>((size_t)CR * NT * HID);
+    if (pf) D.pf_feat = dmalloc<__half>((size_t)WIN * NT * HID);
+    D.xb_feat = frag(NT * HID);
+    D.tpo = dmalloc<float>((size_t)CR * NFR);
+    D.ctxn = dmalloc<__half>((size_t)CR * HID);
+    D.ckva = dmalloc<__half>((size_t)CR * DKVA);
+    D.clat = dmalloc<__half>((size_t)CR * LAT);
+    D.ckvb = dmalloc<__half>((size_t)CR * KVB);
+    D.xb_ctxn = frag(HID); D.xb_clat = frag(LAT);
+    D.kring = dmalloc<__half>((size_t)L * NHR * RING * HD);
+    D.vring = dmalloc<__half>((size_t)L * NHR * RING * HD);
+    D.resid = dmalloc<float>((size_t)Q * HID);
+    D.x = dmalloc<__half>((size_t)Q * HID);
+    D.xb_x = frag(HID);
+    D.bkva = dmalloc<__half>((size_t)Q * DKVA);
+    D.blat = dmalloc<__half>((size_t)Q * LAT);
+    D.bkvb = dmalloc<__half>((size_t)Q * KVB);
+    D.xb_blat = frag(LAT);
+    D.q = dmalloc<__half>((size_t)Q * QW);
+    D.qf = dmalloc<float>((size_t)Q * QW);
+    D.apart = dmalloc<float>((size_t)NHR * SPLIT * Q * (HD + 2));
+    D.ao = dmalloc<__half>((size_t)Q * QW);
+    D.xb_ao = frag(QW);
+    D.part = dmalloc<uint16_t>((size_t)Q * HID);
+    D.g = dmalloc<__half>((size_t)Q * NIR);
+    D.u = dmalloc<__half>((size_t)Q * NIR);
+    D.act = dmalloc<__half>((size_t)Q * NIR);
+    D.xb_act = frag(NIR);
+    D.xf_head = frag(HID);
+    D.vlo = main.vlo; D.vn = main.vn;
+    D.hlog = dmalloc<float>((size_t)Q * D.vn);
+    D.jin = dmalloc<__half>((size_t)16 * JIN);   // fragment tiles are 16 rows: rows 1..15 stay zero
+    G6RT_CK(cudaMemsetAsync(D.jin, 0, (size_t)16 * JIN * 2, st));
+    D.xb_jin = frag(JIN);
+    D.jpo = dmalloc<float>(JOUT);
+    D.state = dmalloc<float>(ST);
+    D.markov = dmalloc<__half>((size_t)16 * ST);
+    G6RT_CK(cudaMemsetAsync(D.markov, 0, (size_t)16 * ST * 2, st));
+    D.xb_markov = frag(ST);
+    D.arlog = dmalloc<float>(D.vn);
+    auto gv = [&](const std::string& name, int tpc, int ks, int M, const u32* xb, void* y, int odt, int K_, int O_, bind::Gv& g) {
+        const TensorRef t = find(name);
+        if (!t.p || t.nd != 3 || t.shape[2] != 512) die("ML4 DSpark pack: " + name + " is not a BF16W record");
+        if (const char* e = bind::make_gv(as_bind(t), bind::BF16W, tpc, ks, M, xb, y, odt, g)) die(name + ": " + e);
+        if (g.K != K_ || g.O != O_) die("ML4 DSpark pack: " + name + " is [" + std::to_string(g.O) + "][" + std::to_string(g.K) + "], want [" +
+                                        std::to_string(O_) + "][" + std::to_string(K_) + "]");
+    };
+    auto vec = [&](const std::string& name, long long n) {
+        const TensorRef t = find(name);
+        if (!t.p || !t.bf16) die("ML4 DSpark pack has no BF16 " + name);
+        long long c = 1;
+        for (int i = 0; i < t.nd; ++i) c *= t.shape[i];
+        if (c != n) die("ML4 DSpark pack: " + name + " has " + std::to_string(c) + " values, want " + std::to_string(n));
+        return static_cast<const __nv_bfloat16*>(t.p);
+    };
+    gv("DS.tp.gv", 1, 32, CR, D.xb_feat, D.tpo, gv::O_F32, NT * HID, NFR, D.tp);
+    D.tnorm = vec("DS.target_norm", HID);
+    D.fnorm = vec("DS.final_norm", HID);
+    D.mask = vec("DS.mask", 2LL * HID);
+    for (int j = 0; j < L; ++j)
+    {
+        DLayer& y = D.ly[j];
+        const std::string p = "DS.L" + std::to_string(j) + ".";
+        gv(p + "kva.gv", 1, 32, CR, D.xb_ctxn, D.ckva, gv::O_F16, HID, DKVA, y.kva_c);
+        gv(p + "kvb.gv", 1, 32, CR, D.xb_clat, D.ckvb, gv::O_F16, LAT, KVB, y.kvb_c);
+        gv(p + "kva.gv", 1, 32, Q, D.xb_x, D.bkva, gv::O_F16, HID, DKVA, y.kva_b);
+        gv(p + "kvb.gv", 1, 32, Q, D.xb_blat, D.bkvb, gv::O_F16, LAT, KVB, y.kvb_b);
+        gv(p + "wq.gv", 1, 16, Q, D.xb_x, D.q, gv::O_F16, HID, QW, y.wq);
+        gv(p + "wo.gv", 2, 8, Q, D.xb_ao, D.part, gv::O_BF16, QW, HID, y.wo);
+        gv(p + "w1.gv", 2, 16, Q, D.xb_x, D.g, gv::O_F16, HID, NIR, y.w1);
+        gv(p + "w3.gv", 2, 16, Q, D.xb_x, D.u, gv::O_F16, HID, NIR, y.w3);
+        gv(p + "w2.gv", 2, 8, Q, D.xb_act, D.part, gv::O_BF16, NIR, HID, y.w2);
+        y.attn_norm = vec(p + "attn_norm", HID);
+        y.ffn_norm = vec(p + "ffn_norm", HID);
+        y.kv_norm = vec(p + "kv_norm", LAT);
+    }
+    gv("DS.jp.gv", 1, 32, 1, D.xb_jin, D.jpo, gv::O_F32, JIN, JOUT, D.jp);
+    D.jbias = vec("DS.jp_bias", JOUT);
+    gv("DS.ar_out.gv", 1, 32, 1, D.xb_markov, D.arlog, gv::O_F32, ST, D.vn, D.ar_out);
+    D.ar_emb = vec("DS.ar_emb", (long long)glue::VOCAB * ST);
+    // the target's lm_head on the draft's final-norm rows
+    bind::HeadTensors ht = main.head_t;
+    ht.eh = bind::Tensor();
+    bind::Scratch sc{};
+    sc.xf_head = D.xf_head;
+    bind::HeadIo io;
+    io.h = D.x; io.logits = D.hlog;
+    if (const char* e = bind::make_head(ht, D.rank, Q, sc, io, D.head)) die(std::string("ML4 DSpark head: ") + e);
+    G6RT_CK(cudaStreamSynchronize(st));
+    size_t wb = bind::gv_bytes(D.tp) + bind::gv_bytes(D.jp) + bind::gv_bytes(D.ar_out);
+    for (const DLayer& y : D.ly) wb += bind::gv_bytes(y.kva_c) + bind::gv_bytes(y.kvb_c) + bind::gv_bytes(y.wq) + bind::gv_bytes(y.wo) +
+                                       bind::gv_bytes(y.w1) + bind::gv_bytes(y.w3) + bind::gv_bytes(y.w2);
+    fprintf(stderr, "# rank %d: ML4 DSpark drafter (3 drafts a round), records %.3f GB, ring %.1f MB, prompt taps %.1f MB\n", D.rank,
+            wb / 1e9, 2.0 * L * NHR * RING * HD * 2 / 1e6, pf ? (double)WIN * NT * HID * 2 / 1e6 : 0.0);
+}
+inline void dfl_head_i4(Dfl&, const uint8_t*, int, int) { die("GR8_DFL_HEAD_I4: not with the ML4 DSpark head"); }
+inline void dfl_body_i4(Dfl&, cudaStream_t) { die("GR8_DFL_BODY_I4: not with the ML4 DSpark head"); }
