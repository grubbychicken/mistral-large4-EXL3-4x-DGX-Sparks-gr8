+// ---------------------------------------------------------------- the step, in phases
+inline void dfl_bfrag(const __half* src, int K_, int M, u32* b16, cudaStream_t st)
+{
+    bind::Xfrag a;
+    a.on = 1; a.src = src; a.ld = K_; a.K = K_; a.M = M; a.f16 = nullptr; a.bf16 = b16;
+    bind::launch(a, st);
+}
+inline void dfl_put(Dfl& D, int c, cudaStream_t st)
+{
+    k_put_publish<<<1, 128, 0, st>>>(reinterpret_cast<const uint4*>(D.part), D.f, D.stepp, c, dfl::Q * (HID * 2 / 16), D.tickets + c);
+}
+inline void dfl_wait(Dfl& D, int c, size_t bytes, cudaStream_t st) { glue::k_wait_peers<<<1, 32, 0, st>>>(D.f, D.stepp, c, bytes, dfl::ERR); }
+inline size_t dfl_payload(const Dfl& D, int c)
+{
+    (void)D;
+    using namespace dfl;
+    if (c == 0) return (size_t)CR * NFR * 4;
+    if (c <= 2 * L) return (size_t)Q * HID * 2;
+    return sizeof(dspk::Pick);
+}
+inline std::vector<uint32_t> dfl_sizes(const Dfl& D, bool query)
+{
+    std::vector<uint32_t> v;
+    for (int c = 0; c < (query ? dfl::NC : 1); ++c) v.push_back((uint32_t)dfl_payload(D, c));
+    return v;
+}
+inline std::vector<uint32_t> dfl_fill_sizes()
+{
+    std::vector<uint32_t> v(dfl::NT, (uint32_t)(dfl::B * HID * 2));
+    v.push_back((uint32_t)(dfl::CR * dfl::NFR * 4));
+    return v;
+}
+inline void dfl_enqueue(g6::Fabric& f, u64 step, const std::vector<uint32_t>& sizes, bool fill)
+{
+    (void)fill;
+    f.enqueue_step(step, sizes);
+}
+// the context part from collective c (tp slices): target_norm, every layer's keys / values of the context rows -> ring
+inline void dfl_ctx_store(Dfl& D, int c, cudaStream_t st)
+{
+    using namespace dfl;
+    dfl_wait(D, c, (size_t)CR * NFR * 4, st);
+    dspk::k_ctx_norm<<<CR, 256, 0, st>>>(dspk::CtxArgs{D.f, D.stepp, c, D.tnorm, D.ctxn, D.eps, D.cell});
+    dfl_bfrag(D.ctxn, HID, CR, D.xb_ctxn, st);
+    for (int j = 0; j < L; ++j)
+    {
+        DLayer& y = D.ly[j];
+        bind::launch(y.kva_c, st);
+        dspk::k_rms<<<CR, 256, 0, st>>>(nullptr, D.ckva, DKVA, LAT, y.kv_norm, D.eps, D.clat, LAT, D.cell + C_ROWS);
+        dfl_bfrag(D.clat, LAT, CR, D.xb_clat, st);
+        bind::launch(y.kvb_c, st);
+        dspk::k_kv<<<dim3(CR, NHR), 128, 0, st>>>(dspk::KvArgs{D.ckva, D.ckvb, D.freq, D.kring + (size_t)j * NHR * RING * HD,
+                                                               D.vring + (size_t)j * NHR * RING * HD, D.cell, D.qpos, 1});
+    }
+}
+// attention block of layer j (x = its attention_norm output) up to the publish of collective 1 + 2j
+inline void dfl_attn(Dfl& D, int j, cudaStream_t st)
+{
+    using namespace dfl;
+    DLayer& y = D.ly[j];
+    dfl_bfrag(D.x, HID, Q, D.xb_x, st);
+    bind::launch(y.wq, st);
+    bind::launch(y.kva_b, st);
+    dspk::k_q<<<dim3(Q, NHR), 128, 0, st>>>(D.q, D.freq, D.qpos, D.qf);
+    dspk::k_rms<<<Q, 256, 0, st>>>(nullptr, D.bkva, DKVA, LAT, y.kv_norm, D.eps, D.blat, LAT, nullptr);
+    dfl_bfrag(D.blat, LAT, Q, D.xb_blat, st);
+    bind::launch(y.kvb_b, st);
+    __half *kr = D.kring + (size_t)j * NHR * RING * HD, *vr = D.vring + (size_t)j * NHR * RING * HD;
+    dspk::k_kv<<<dim3(Q, NHR), 128, 0, st>>>(dspk::KvArgs{D.bkva, D.bkvb, D.freq, kr, vr, D.cell, D.qpos, 0});
+    dspk::k_attn<<<dim3(NHR, SPLIT), 128, 0, st>>>(dspk::AttnArgs{D.qf, kr, vr, D.cell, D.apart});
+    dspk::k_attn_join<<<NHR, 128, 0, st>>>(D.apart, D.ao);
+    dfl_bfrag(D.ao, QW, Q, D.xb_ao, st);
+    bind::launch(y.wo, st);
+    dfl_put(D, 1 + 2 * j, st);
+}
+// MLP block of layer j (x = its ffn_norm output) up to the publish of collective 2 + 2j
+inline void dfl_mlp(Dfl& D, int j, cudaStream_t st)
+{
+    using namespace dfl;
+    DLayer& y = D.ly[j];
+    dfl_bfrag(D.x, HID, Q, D.xb_x, st);
+    bind::launch(y.w1, st);
+    bind::launch(y.w3, st);
+    dspk::k_swiglu<<<(Q * NIR + 255) / 256, 256, 0, st>>>(D.g, D.u, D.act, Q * NIR);
+    dfl_bfrag(D.act, NIR, Q, D.xb_act, st);
+    bind::launch(y.w2, st);
+    dfl_put(D, 2 + 2 * j, st);
+}
+inline void dfl_consume(Dfl& D, int c, const __nv_bfloat16* w, cudaStream_t st)
+{
+    dfl_wait(D, c, dfl_payload(D, c), st);
+    dspk::k_sum_norm<<<dfl::Q, 256, 0, st>>>(dspk::SumArgs{D.f, D.stepp, c, D.resid, w, D.x, D.eps});
+}
+// row i of the autoregressive head up to the publish of its picks (collective 7 + i)
+inline void dfl_ar(Dfl& D, int i, cudaStream_t st)
+{
+    using namespace dfl;
+    dspk::k_joint<<<1, 256, 0, st>>>(D.state, D.ar_emb, D.x, D.tok, D.sel_tok, i, D.jin);
+    dfl_bfrag(D.jin, JIN, 1, D.xb_jin, st);
+    bind::launch(D.jp, st);
+    dspk::k_rnn<<<1, 256, 0, st>>>(D.jpo, D.jbias, D.state, D.markov, i);
+    dfl_bfrag(D.markov, ST, 1, D.xb_markov, st);
+    bind::launch(D.ar_out, st);
+    const int c = 1 + 2 * L + i;
+    dspk::k_pick<<<1, 1024, 0, st>>>(D.hlog + (size_t)i * D.vn, D.arlog, D.vn, D.vlo, D.f, D.stepp, c, D.tickets + c);
+}
+inline void dfl_in(Dfl& D, cudaStream_t st)
+{
+    dspk::k_in<<<1, 128, 0, st>>>(dspk::InArgs{reinterpret_cast<const uint32_t*>(D.in), D.stepp, D.cell, D.tok, D.qpos});
+}
+// phase p (0..NPH-1). query = false: the context part only (phases 0 and 1, phase 1 without the block)
+inline void dfl_phase(Dfl& D, int p, cudaStream_t st, bool query = true)
+{
+    using namespace dfl;
+    if (p == 0)
+    {
+        dfl_in(D, st);
+        dfl_bfrag(D.feat, NT * HID, CR, D.xb_feat, st);
+        bind::launch(D.tp, st);
+        k_put_publish<<<16, 128, 0, st>>>(reinterpret_cast<const uint4*>(D.tpo), D.f, D.stepp, 0, (int)(dfl_payload(D, 0) / 16), D.tickets);
+        return;
+    }
+    if (p == 1)
+    {
+        dfl_ctx_store(D, 0, st);
+        if (!query) return;
+        dspk::k_block_in<<<Q, 256, 0, st>>>(D.emb, D.tok, D.mask, D.resid);
+        dspk::k_rms<<<Q, 256, 0, st>>>(D.resid, nullptr, HID, HID, D.ly[0].attn_norm, D.eps, D.x, HID, nullptr);
+        dfl_attn(D, 0, st);
+        return;
+    }
+    if (p <= 2 * L)                   // even p = 2 + 2j: layer j's attention partial in, its MLP out; odd p = 3 + 2j: MLP in, layer j + 1 out
+    {
+        const int j = (p - 2) / 2;
+        if (p % 2 == 0)
+        {
+            dfl_consume(D, p - 1, D.ly[j].ffn_norm, st);
+            dfl_mlp(D, j, st);
+        }
+        else
+        {
+            dfl_consume(D, p - 1, D.ly[j + 1].attn_norm, st);
+            dfl_attn(D, j + 1, st);
+        }
+        return;
+    }
+    if (p == 2 * L + 1)               // the last MLP in, final_norm, the target head, the autoregressive row 0
+    {
+        dfl_consume(D, p - 1, D.fnorm, st);
+        bind::launch(D.head.xf_h, st);
+        bind::launch(D.head.lm_head, st);
+        dspk::k_softcap<<<(Q * D.vn + 255) / 256, 256, 0, st>>>(D.hlog, Q * D.vn);
+        dfl_ar(D, 0, st);
+        return;
+    }
+    const int i = p - (2 * L + 1);    // 1 .. Q: row i-1's picks merged; row i's head, or the output
+    const int c = 1 + 2 * L + i - 1;
+    dfl_wait(D, c, sizeof(dspk::Pick), st);
+    dspk::k_pick_merge<<<1, 32, 0, st>>>(D.f, D.stepp, c, D.sel_tok, i - 1);
+    if (i < Q) dfl_ar(D, i, st);
+    else dspk::k_out<<<1, 32, 0, st>>>(D.sel_tok, D.out);
+}
+inline void dfl_step(Dfl& D, cudaStream_t st, bool query = true)
+{
+    for (int p = 0; p < (query ? dfl::NPH : 2); ++p) dfl_phase(D, p, st, query);
+}
+constexpr bool dfl_delivered(int p, bool query) { return p < dfl::NC && (query || p == 0); }
+// a fill step (prompt context from Dfl::pf_feat, B rows): 0 = the NT feature gathers out; 1 = in, tp slices out
+// (collective NT); 2 = the context part
+constexpr int DFL_FILL_PH = 3;
+inline void dfl_fill_phase(Dfl& D, int p, cudaStream_t st)
+{
+    using namespace dfl;
+    if (p == 0)
+    {
+        dfl_in(D, st);
+        for (int s = 0; s < NT; ++s) dspk::k_fill_put<<<1, 128, 0, st>>>(D.pf_feat, D.cell, s, D.f, D.stepp, D.tickets + s);
+        return;
+    }
+    if (p == 1)
+    {
+        for (int s = 0; s < NT; ++s) dfl_wait(D, s, (size_t)B * HID * 2, st);
+        dspk::k_fill_get<<<dim3(HID / 256, B, NT), 256, 0, st>>>(D.f, D.stepp, D.feat);
+        dfl_bfrag(D.feat, NT * HID, CR, D.xb_feat, st);
+        bind::launch(D.tp, st);
+        k_put_publish<<<16, 128, 0, st>>>(reinterpret_cast<const uint4*>(D.tpo), D.f, D.stepp, NT, (int)((size_t)CR * NFR * 4 / 16), D.tickets + NT);
+        return;
+    }
+    dfl_ctx_store(D, NT, st);
+}
+inline void dfl_fill_step(Dfl& D, cudaStream_t st)
+{
+    for (int p = 0; p < DFL_FILL_PH; ++p) dfl_fill_phase(D, p, st);
+}
+inline void dfl_dump_step(FILE* f, const Dfl& D, const DflIn& di, const DflOut* o)
+{
+    if (!f) return;
+    int h[12] = {o ? 1 : 0, di.ctx_pos0, di.ctx_rows, di.q0, di.tok0};
+    for (int r = 1; r < dfl::B; ++r) h[4 + r] = o ? o->tok[r] : -1;
+    fwrite(h, 4, 12, f);
+    std::vector<__half> v((size_t)di.ctx_rows * dfl::NT * HID);
+    G6RT_CK(cudaMemcpy(v.data(), D.feat, v.size() * 2, cudaMemcpyDeviceToHost));
+    fwrite(v.data(), 2, v.size(), f);
+}
+inline void dfl_dump_tokens(FILE* f, const std::vector<int>& t)
+{
+    if (!f) return;
+    int h[12] = {2, (int)t.size()};
+    fwrite(h, 4, 12, f);
+    fwrite(t.data(), 4, t.size(), f);
+    fflush(f);
+}
+
+// ---------------------------------------------------------------- the target side
+inline Dfl*& dfl_of(const Model& m)
+{
+    static Dfl* by_rank[8] = {};
+    return by_rank[m.rank & 7];
+}
+inline void dfl_tap_launch(Model& m, int i, int M, cudaStream_t st)
+{
+    Dfl* D = dfl_of(m);
+    for (int s = 0; s < dfl::NT; ++s)
+        if (D->tlayer[s] == m.layers[i].l) dspk::k_tap<<<dim3(HID / 256, M), 256, 0, st>>>(m.resid, D->feat, s);
+}
+inline void dfl_pf_tap_launch(Model& m, Prefill& P, int i, int M, cudaStream_t st)
+{
+    Dfl* D = dfl_of(m);
+    if (!D->pf_feat || D->pf_hi <= D->pf_lo) return;
+    for (int s = 0; s < dfl::NT; ++s)
+    {
+        if (D->tlayer[s] != m.layers[i].l) continue;
+        const int r0 = P.rs ? pf_r0(M, P.f.rank, P.f.nr) : 0, rows = P.rs ? pf_rows(M, P.f.rank, P.f.nr) : P.f.rank == 0 ? M : 0;
+        if (rows > 0) dspk::k_pf_tap<<<dim3(HID / 256, rows), 256, 0, st>>>(P.resid, P.pos, r0, D->pf_lo, D->pf_hi, D->pf_feat, s);
+    }
+}
+inline void dfl_attach(Model& m, Dfl& D)
+{
+    for (int s = 0; s < dfl::NT; ++s)
+    {
+        bool found = false;
+        for (const Layer& y : m.layers) found |= y.l == D.tlayer[s];
+        if (!found) die("--dflash: target layer " + std::to_string(D.tlayer[s]) + " is not in --layers");
+    }
+    dfl_of(m) = &D;
+    m.dfl_tap = dfl_tap_launch;
+}
+}   // namespace g6rt
