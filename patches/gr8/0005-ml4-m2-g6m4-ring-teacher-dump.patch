diff --git a/engine/runtime/teacher_dump.h b/engine/runtime/teacher_dump.h
new file mode 100644
index 0000000..af7264d
--- /dev/null
+++ b/engine/runtime/teacher_dump.h
@@ -0,0 +1,73 @@
+#pragma once
+// GR8_TEACHER_DUMP=DIR (offline g6m4): a compact teacher-forced scoring dump against a reference's candidate ids.
+// Every --prompt is one sequence of S tokens (all the same length); DIR/ids.i32 holds int32 [Nq][S][K] token ids (the
+// reference's top K per row), K = its size / (Nq * S * 4). Each rank writes DIR/r<rank>.tf, float32 [Nq][S][4 + K] at
+// row (q, pos): this rank's vocab slice log-sum-exp (computed in double), its slice maximum, its argmax token id (as a
+// float, exact below 2^24), the logit of the next prompt token (-inf outside the slice or on the last row), then the
+// logits of the K ids (-inf outside the slice). Logits are the head's final ones (ML4: after the softcap). The
+// log-softmax over the whole vocabulary is the ranks' log-sum-exps combined (tools/q5_teacher_merge.py in the recipe).
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+struct TeacherDump
+{
+    int ids_fd = -1, out_fd = -1, Nq = 0, S = 0, K = 0, vlo = 0, vn = 0;
+    std::vector<int32_t> ids;
+    std::vector<float> rec, lg;
+    bool on() const { return out_fd >= 0; }
+    // "" on success, else the message
+    std::string open(const std::string& dir, int rank, int nq, int s, int vlo_, int vn_)
+    {
+        const std::string in = dir + "/ids.i32", out = dir + "/r" + std::to_string(rank) + ".tf";
+        ids_fd = ::open(in.c_str(), O_RDONLY);
+        if (ids_fd < 0) return "cannot open " + in;
+        struct stat sb;
+        if (fstat(ids_fd, &sb) || nq <= 0 || s <= 0 || sb.st_size % ((off_t)nq * s * 4))
+            return in + ": size is not a multiple of prompts x prompt length x 4";
+        Nq = nq; S = s; K = (int)(sb.st_size / ((off_t)nq * s * 4)); vlo = vlo_; vn = vn_;
+        out_fd = ::open(out.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+        if (out_fd < 0) return "cannot open " + out;
+        ids.resize(K); rec.resize(4 + (size_t)K);
+        return "";
+    }
+    // rows j of a step: sequence q, positions pos[j], logits [M][vn] of this rank's slice (device copy done by the caller)
+    void rows(int q, const int* pos, int M, const float* logits, const std::vector<int>& prompt)
+    {
+        for (int j = 0; j < M; ++j)
+        {
+            const int p = pos[j];
+            if (p < 0 || p >= S) continue;
+            const float* x = logits + (size_t)j * vn;
+            int am = 0;
+            for (int v = 1; v < vn; ++v) if (x[v] > x[am]) am = v;
+            double se = 0.0;
+            for (int v = 0; v < vn; ++v) se += std::exp((double)x[v] - (double)x[am]);
+            rec[0] = (float)((double)x[am] + std::log(se));
+            rec[1] = x[am];
+            rec[2] = (float)(vlo + am);
+            const int nx = p + 1 < S ? prompt[p + 1] - vlo : -1;
+            rec[3] = nx >= 0 && nx < vn ? x[nx] : -INFINITY;
+            const off_t row = (off_t)q * S + p;
+            if (pread(ids_fd, ids.data(), (size_t)K * 4, row * K * 4) != (ssize_t)K * 4) { fprintf(stderr, "GR8_TEACHER_DUMP: ids read failed\n"); _exit(3); }
+            for (int k = 0; k < K; ++k)
+            {
+                const int v = ids[k] - vlo;
+                rec[4 + k] = v >= 0 && v < vn ? x[v] : -INFINITY;
+            }
+            const size_t nb = rec.size() * 4;
+            if (pwrite(out_fd, rec.data(), nb, row * (off_t)nb) != (ssize_t)nb) { fprintf(stderr, "GR8_TEACHER_DUMP: write failed\n"); _exit(3); }
+        }
+    }
+    void close()
+    {
+        if (ids_fd >= 0) ::close(ids_fd);
+        if (out_fd >= 0) { fsync(out_fd); ::close(out_fd); }
+        ids_fd = out_fd = -1;
+    }
+};
