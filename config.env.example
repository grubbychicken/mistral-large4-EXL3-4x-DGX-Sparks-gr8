# Copy this file to config.env and remove the # from the lines that you want to change.
# All settings and their defaults are in scripts/config.sh.

# The four Sparks as ssh targets: this Spark first, then in the order of the ring.
# Leave this out and ./start.sh finds them.
#SPARKS="192.168.1.11 192.168.1.12 192.168.1.13 192.168.1.14"

#PORT=8000                # the port of the API
#BIND_HOST=0.0.0.0        # let other computers on your network use the API (it has no password)
#CONTEXT=65536            # tokens in one request, prompt and reply together
#SESSIONS=4               # requests that run at the same time
#REASONING_EFFORT=low     # the default when a request does not set reasoning_effort
#MEMGUARD_FLOOR_GIB=3     # the memory guard stops the server under this much free memory
#MODEL_DIR=/data/Mistral-Large-4-1T-A52B-EXL3-3.0bpw   # where the 403 GB download goes
#HF_TOKEN=hf_...          # your Hugging Face token, if Hugging Face asks for one
